# Konfiguracja wdrożenia - skopiuj do .env (plik .env NIE trafia do repozytorium) i uzupełnij.

# Domena aplikacji (rekord DNS A/AAAA wskazujący na serwer); Caddy uzyska dla niej certyfikat HTTPS
DOMAIN=faktury.example.pl

# Hasło do bazy danych - długie i losowe, np.: openssl rand -base64 32
DB_PASSWORD=

# Poczta (opcjonalnie - bez niej funkcje e-mail są wyłączone): serwer SMTP dostawcy poczty transakcyjnej
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=faktury@example.pl

# Certyfikat chroniący klucze szyfrowania tokenów KSeF (zalecane) - plik w deploy/secrets/, patrz docs/wdrozenie.md
DP_CERT_PATH=/run/secrets/app/dataprotection.pfx
DP_CERT_PASSWORD=
