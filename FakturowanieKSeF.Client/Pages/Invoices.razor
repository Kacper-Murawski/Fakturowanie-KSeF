@page "/faktury"
@inject ApiClient Api
@inject NavigationManager Navigation
@inject CompanyContext Ctx

<PageTitle>Faktury - Fakturowanie KSeF</PageTitle>

<div class="page-header">
    <div>
        <h1>Faktury</h1>
        <p class="page-subtitle">Faktury sprzedaży wystawione w aplikacji i pobrane z KSeF</p>
    </div>
    @if (Ctx.CanIssue)
    {
        <div class="page-actions">
            <button class="btn btn-outline-secondary" disabled="@importing" @onclick="ImportAsync"
                    title="Faktury sprzedażowe wystawione w innym programie lub aplikacji MF, przesłane do KSeF">
                <Icon Name="refresh" Size="17" />
                @(importing ? "Pobieranie…" : "Pobierz z KSeF wystawione poza aplikacją")
            </button>
            <a class="btn btn-primary" href="faktury/nowa"><Icon Name="plus" Size="17" Stroke="2.2" /> Nowa faktura</a>
        </div>
    }
</div>

@if (importResult is { } ir)
{
    <div class="alert alert-success" role="status" data-testid="import-result">
        Pobrano faktury wystawione poza aplikacją: @ir.Downloaded@(ir.Skipped > 0 ? $" (pominięto nieobsługiwane: {ir.Skipped})" : "").
        @(ir.Complete ? "" : "Pozostałe zostaną pobrane w kolejnym przebiegu.")
    </div>
}

<ProblemAlert Problem="problem" />

<section class="table-card" aria-label="Lista faktur">
    <div class="table-card-toolbar">
        <div class="segmented" role="group" aria-label="Status faktur" data-testid="status-tabs">
            @foreach (var (value, label) in StatusTabs)
            {
                <button type="button" class="@((Status ?? "") == value ? "active" : null)" aria-pressed="@((Status ?? "") == value ? "true" : "false")"
                        @onclick="() => SetStatusAsync(value)">@label</button>
            }
        </div>
        <div class="filters">
            <div class="filter-search">
                <label class="visually-hidden" for="q">Szukaj</label>
                <Icon Name="search" Size="16" Stroke="2" />
                <input id="q" type="search" class="form-control" placeholder="Numer, nabywca, NIP, numer KSeF…" @bind="Q" @bind:event="oninput" @bind:after="SearchAsync" />
            </div>
            <label class="visually-hidden" for="payment">Płatność</label>
            <select id="payment" class="form-select" @bind="Payment" @bind:after="ApplyFiltersAsync">
                <option value="">Płatność: wszystkie</option>
                <option value="@PaymentFilter.Unpaid">Nieopłacone</option>
                <option value="@PaymentFilter.Overdue">Po terminie</option>
                <option value="@PaymentFilter.Paid">Opłacone</option>
            </select>
            <span class="filter-dates">
                <label class="visually-hidden" for="from">Wystawione od</label>
                <input id="from" type="date" class="form-control" title="Wystawione od" @bind="From" @bind:after="ApplyFiltersAsync" />
                <span class="muted" aria-hidden="true">–</span>
                <label class="visually-hidden" for="to">Wystawione do</label>
                <input id="to" type="date" class="form-control" title="Wystawione do" @bind="To" @bind:after="ApplyFiltersAsync" />
            </span>
        </div>
    </div>

    @if (data is null)
    {
        <p class="muted p-4 mb-0">Wczytywanie…</p>
    }
    else if (data.TotalCount == 0)
    {
        <div class="empty-state">
            <span class="empty-icon"><Icon Name="file" Size="24" /></span>
            <h2>Brak faktur</h2>
            <p>Brak faktur spełniających kryteria.</p>
            @if (Ctx.CanIssue && !HasFilters)
            {
                <a class="btn btn-primary" href="faktury/nowa"><Icon Name="plus" Size="17" Stroke="2.2" /> Wystaw pierwszą fakturę</a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle table-stack">
                <thead>
                    <tr>
                        <th>Numer</th><th>Nabywca</th><th>Wystawiona</th>
                        <th class="text-end">Brutto</th><th>KSeF</th><th>Płatność</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in data.Items)
                    {
                        <tr role="button" @onclick="() => Open(i.Id)">
                            <td data-col="main">
                                <a class="row-link" href="faktury/@i.Id">@i.Number</a>
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    @if (i.Kind == InvoiceKind.Correction)
                                    {
                                        <span class="pill pill-warning" title="Faktura korygująca">KOR</span>
                                    }
                                    @if (i.Kind == InvoiceKind.Proforma)
                                    {
                                        <span class="pill pill-info" title="Faktura proforma - nie trafia do KSeF">PRO</span>
                                    }
                                    @if (i.Origin == InvoiceOrigin.KsefImport)
                                    {
                                        <span class="pill" title="Wystawiona poza aplikacją, pobrana z KSeF">spoza aplikacji</span>
                                    }
                                </div>
                            </td>
                            <td data-col="party">@i.BuyerName<div class="cell-sub text-nowrap">@(i.BuyerNip is null ? "" : "NIP " + Format.Nip(i.BuyerNip))</div></td>
                            <td data-col="date" data-label="Wystawiona" class="text-nowrap">@Format.Date(i.IssueDate)</td>
                            <td data-col="amount" class="text-end text-nowrap">
                                <span class="cell-main">@Format.Money(i.TotalGross, i.Currency)</span>
                                <div class="cell-sub">netto @Format.Money(i.TotalNet, i.Currency)</div>
                            </td>
                            <td data-col="status">
                                @if (i.Kind == InvoiceKind.Proforma)
                                {
                                    <span class="pill pill-info">proforma</span>
                                }
                                else
                                {
                                    <StatusBadge Status="i.Status" />
                                }
                            </td>
                            <td data-col="payment">
                                <PaymentBadge Status="i.PaymentStatus" IsOverdue="i.IsOverdue" />
                                @if (i.PaymentStatus is not null && i.DueDate is not null && i.PaymentStatus != PaymentStatus.Paid)
                                {
                                    <div class="cell-sub mt-1">termin @Format.Date(i.DueDate)</div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <nav class="table-card-footer" aria-label="Stronicowanie">
            <span class="muted">Faktury @((data.Page - 1) * data.PageSize + 1)–@Math.Min(data.Page * data.PageSize, data.TotalCount) z @data.TotalCount</span>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary btn-sm" disabled="@(data.Page <= 1)" @onclick="() => GoToPageAsync(data.Page - 1)"><Icon Name="chevron-left" Size="16" /> Poprzednia</button>
                <button class="btn btn-outline-secondary btn-sm" disabled="@(data.Page * data.PageSize >= data.TotalCount)" @onclick="() => GoToPageAsync(data.Page + 1)">Następna <Icon Name="chevron-right" Size="16" /></button>
            </div>
        </nav>
    }
</section>

@code {
    protected override async Task OnInitializedAsync() => await Ctx.EnsureLoadedAsync();

    // Filtry w adresie strony - można je zapisać w zakładkach i wracać przyciskiem „wstecz”
    [SupplyParameterFromQuery(Name = "status")] public string? Status { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "payment")] public string? Payment { get; set; }
    [SupplyParameterFromQuery(Name = "from")] public DateOnly? From { get; set; }
    [SupplyParameterFromQuery(Name = "to")] public DateOnly? To { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? PageNumber { get; set; }

    private PagedResult<InvoiceListItemDto>? data;
    private ApiProblem? problem;
    private CancellationTokenSource? debounce;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private bool importing;
    private SyncResultDto? importResult;

    /// <summary>Import faktur sprzedażowych wystawionych poza aplikacją (D44).</summary>
    private async Task ImportAsync()
    {
        importing = true;
        importResult = null;
        var result = await Api.PostAsync<SyncResultDto>("api/invoices/import-from-ksef", new { });
        importing = false;
        problem = result.Problem;
        importResult = result.Value;
        if (importResult is not null) await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var query = new List<string> { $"page={PageNumber ?? 1}", "pageSize=20" };
        if (!string.IsNullOrEmpty(Status)) query.Add($"status={Status}");
        if (!string.IsNullOrEmpty(Payment)) query.Add($"payment={Payment}");
        if (!string.IsNullOrWhiteSpace(Q)) query.Add($"q={Uri.EscapeDataString(Q)}");
        if (From is not null) query.Add($"from={From:yyyy-MM-dd}");
        if (To is not null) query.Add($"to={To:yyyy-MM-dd}");

        var result = await Api.GetAsync<PagedResult<InvoiceListItemDto>>($"api/invoices?{string.Join('&', query)}");
        problem = result.Problem;
        data = result.Value ?? new PagedResult<InvoiceListItemDto>([], 0, 1, 20);
    }

    private async Task SearchAsync()
    {
        debounce?.Cancel();
        debounce = new CancellationTokenSource();
        try { await Task.Delay(300, debounce.Token); } catch (TaskCanceledException) { return; }
        await ApplyFiltersAsync();
    }

    private Task ApplyFiltersAsync()
    {
        PageNumber = 1;
        UpdateUrl();
        return Task.CompletedTask;
    }

    private Task GoToPageAsync(int number)
    {
        PageNumber = number;
        UpdateUrl();
        return Task.CompletedTask;
    }

    private static readonly (string Value, string Label)[] StatusTabs =
    [
        ("", "Wszystkie"),
        (nameof(InvoiceStatus.Draft), "Szkice"),
        (nameof(InvoiceStatus.Pending), "Wysłane"),
        (nameof(InvoiceStatus.Accepted), "W KSeF"),
        (nameof(InvoiceStatus.Rejected), "Odrzucone")
    ];

    private bool HasFilters => !string.IsNullOrEmpty(Status) || !string.IsNullOrEmpty(Payment) || !string.IsNullOrWhiteSpace(Q) || From is not null || To is not null;

    private Task SetStatusAsync(string value)
    {
        Status = value.Length == 0 ? null : value;
        return ApplyFiltersAsync();
    }

    private void Open(int id) => Navigation.NavigateTo($"faktury/{id}");

    private void UpdateUrl()
    {
        var url = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["status"] = string.IsNullOrEmpty(Status) ? null : Status,
            ["payment"] = string.IsNullOrEmpty(Payment) ? null : Payment,
            ["q"] = string.IsNullOrWhiteSpace(Q) ? null : Q,
            ["from"] = From?.ToString("yyyy-MM-dd"),
            ["to"] = To?.ToString("yyyy-MM-dd"),
            ["page"] = PageNumber is > 1 ? PageNumber : null
        });
        Navigation.NavigateTo(url);
    }
}
