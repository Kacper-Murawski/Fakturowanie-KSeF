@page "/faktury/nowa"
@page "/faktury/{Id:int}/edycja"
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>@Title - Fakturowanie KSeF</PageTitle>

<div class="page-header">
    <div>
        <a class="small fw-semibold d-inline-flex align-items-center gap-1 mb-1" href="@(Id is null ? "faktury" : $"faktury/{Id}")"><Icon Name="chevron-left" Size="15" /> @(Id is null ? "Faktury" : "Wróć do faktury")</a>
        <h1>@Title</h1>
        <p class="page-subtitle">Wypełnij trzy kroki - kwoty i podsumowanie liczą się na bieżąco.</p>
    </div>
</div>
@if (templateNumber is not null)
{
    <div class="alert alert-info" role="status" data-testid="template-info">
        Nowa faktura na podstawie <strong>@templateNumber</strong>: skopiowano nabywcę, pozycje i warunki płatności.
        Numer i daty są nowe - sprawdź dane przed zapisaniem.
    </div>
}

@if (companyMissing)
{
    <div class="alert alert-info">Przed wystawieniem faktury <a href="firma">uzupełnij dane swojej firmy</a> - pojawią się one jako sprzedawca.</div>
}
else if (model is null)
{
    <ProblemAlert Problem="problem" />
    @if (problem is null)
    {
        <p class="text-muted">Wczytywanie…</p>
    }
}
else
{
    <EditForm Model="model" OnValidSubmit="SaveAsync" FormName="invoice">
        <DeepValidator @ref="validator" />
        <ProblemAlert Problem="problem" />
        <ValidationSummary class="text-danger small" />

        @if (Id is null && !IsCorrection)
        {
            <div class="btn-group mb-3 kind-switch" role="group" aria-label="Rodzaj dokumentu" data-testid="document-kind">
                <input type="radio" class="btn-check" name="kind" id="kind-vat" checked="@(!model.IsProforma)" @onchange="() => SetProformaAsync(false)" />
                <label class="btn btn-outline-primary" for="kind-vat">Faktura VAT</label>
                <input type="radio" class="btn-check" name="kind" id="kind-proforma" checked="@model.IsProforma" @onchange="() => SetProformaAsync(true)" />
                <label class="btn btn-outline-primary" for="kind-proforma">Faktura proforma</label>
            </div>
        }
        @if (model.IsProforma)
        {
            <div class="alert alert-secondary small" data-testid="proforma-info">
                Proforma to dokument handlowy (np. prośba o przedpłatę) - <strong>nie jest fakturą VAT i nie trafia do KSeF</strong>.
                Po zapłacie wystawisz na jej podstawie fakturę VAT jednym przyciskiem.
            </div>
        }

        <div class="form-layout">
            <div class="form-main">
        @* ---------------- Korekta: faktura korygowana i przyczyna ---------------- *@
        @if (IsCorrection)
        {
            <section class="surface form-step form-step-warning" data-testid="correction-header" aria-labelledby="step-correction">
                <div>
                    <div class="step-head"><span class="step-num">1</span><h2 id="step-correction">Faktura korygowana</h2></div>
                    <p class="mb-3">
                        <strong>@corrected?.Number</strong> z dnia @Format.Date(corrected?.IssueDate), numer KSeF @corrected?.KsefNumber
                        <br />Nabywca: <strong>@corrected?.Buyer.Name</strong>@(corrected?.Buyer.Nip is { } nip ? $", NIP {Format.Nip(nip)}" : "")
                    </p>
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label" for="reason">Przyczyna korekty</label>
                            <InputTextLive id="reason" class="form-control" @bind-Value="model.CorrectionReason" placeholder="np. rabat, zwrot towaru, błędna cena" />
                            <ValidationMessage For="() => model.CorrectionReason" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="correction-type">Skutek w ewidencji VAT</label>
                            <InputSelect id="correction-type" class="form-select" @bind-Value="model.CorrectionType">
                                <option value="">nie określono</option>
                                @foreach (var t in Enum.GetValues<CorrectionType>())
                                {
                                    <option value="@t">@Format.CorrectionType(t)</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                </div>
            </section>
        }
        else
        {
        @* ---------------- Nabywca ---------------- *@
        <section class="surface form-step" aria-labelledby="step-buyer">
            <div>
                <div class="step-head"><span class="step-num">1</span><h2 id="step-buyer">Nabywca</h2></div>
                <div class="mb-3">
                    <label class="form-label" for="customer">Kontrahent</label>
                    <select id="customer" class="form-select" value="@(model.CustomerId?.ToString() ?? "")" @onchange="OnCustomerChanged">
                        <option value="">— wpisz dane nabywcy ręcznie —</option>
                        @foreach (var c in customers)
                        {
                            <option value="@c.Id">@c.Name @(c.Nip is null ? "" : $"(NIP {Format.Nip(c.Nip)})")</option>
                        }
                    </select>
                    <ValidationMessage For="() => model.Buyer" />
                </div>

                @if (model.CustomerId is null && model.Buyer is not null)
                {
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label" for="buyer-name">Nazwa / imię i nazwisko</label>
                            <InputTextLive id="buyer-name" class="form-control" @bind-Value="model.Buyer.Name" />
                            <ValidationMessage For="() => model.Buyer.Name" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="buyer-nip">NIP (puste dla osoby prywatnej)</label>
                            <VatRegistryLookup Nip="@model.Buyer.Nip" OnFound="FillBuyerFromRegistry" Revalidate="[model.Buyer, model.Buyer.Address]">
                                <InputTextLive id="buyer-nip" class="form-control" @bind-Value="model.Buyer.Nip" />
                            </VatRegistryLookup>
                            <ValidationMessage For="() => model.Buyer.Nip" />
                        </div>
                    </div>
                    <AddressFields Address="model.Buyer.Address" IdPrefix="buyer" />
                }
                else if (SelectedCustomer is { } sc)
                {
                    <div class="party-card">
                        <span class="app-avatar">@sc.Name[..1]</span>
                        <span>
                            <strong>@sc.Name</strong>
                            <span class="d-block muted small">@(sc.Nip is null ? "osoba prywatna" : $"NIP {Format.Nip(sc.Nip)}") · @sc.Address.Street, @sc.Address.PostalCode @sc.Address.City</span>
                        </span>
                    </div>
                }
            </div>
        </section>
        }

        @* ---------------- Nagłówek ---------------- *@
        <section class="surface form-step" aria-labelledby="step-dates">
            <div class="step-head"><span class="step-num">2</span><h2 id="step-dates">Numer, daty i płatność</h2></div>
            <div class="row g-3">
                <div class="col-md-6 col-xl-4">
                    <label class="form-label" for="number">Numer faktury</label>
                    <InputTextLive id="number" class="form-control" @bind-Value="model.Number" placeholder="@suggestedNumber" />
                    <div class="form-text">@(Id is null ? "Puste - numer zostanie nadany automatycznie." : "")</div>
                    <ValidationMessage For="() => model.Number" />
                </div>
                <div class="col-sm-6 col-xl-4">
                    <label class="form-label" for="issue">Data wystawienia</label>
                    <InputDate id="issue" class="form-control" @bind-Value="model.IssueDate" @bind-Value:after="OnDatesChangedAsync" />
                </div>
                <div class="col-sm-6 col-xl-4">
                    <label class="form-label" for="sale">Data sprzedaży</label>
                    <InputDate id="sale" class="form-control" @bind-Value="model.SaleDate" @bind-Value:after="LoadRateAsync" />
                    <div class="form-text">Jeśli inna niż wystawienia.</div>
                </div>
                <div class="col-sm-6 col-xl-4">
                    <label class="form-label" for="place">Miejsce wystawienia</label>
                    <InputTextLive id="place" class="form-control" @bind-Value="model.IssuePlace" />
                </div>
                <div class="col-sm-6 col-xl-4">
                    <label class="form-label" for="currency">Waluta</label>
                    <InputSelect id="currency" class="form-select" @bind-Value="model.Currency" @bind-Value:after="LoadRateAsync" disabled="@IsCorrection">
                        @foreach (var c in Currencies.Supported)
                        {
                            <option value="@c">@c</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => model.Currency" />
                </div>
            </div>
            <hr class="my-4" />
            <div class="row g-3">
                <div class="col-sm-6 col-xl-4">
                    <label class="form-label" for="payment">Forma płatności</label>
                    <InputSelect id="payment" class="form-select" @bind-Value="model.PaymentMethod">
                        @foreach (var m in Enum.GetValues<PaymentMethod>())
                        {
                            <option value="@m">@Format.Payment(m)</option>
                        }
                    </InputSelect>
                </div>
                @if (model.PaidOn is null)
                {
                    <div class="col-sm-6 col-xl-4">
                        <label class="form-label" for="due">Termin płatności</label>
                        <InputDate id="due" class="form-control" @bind-Value="model.DueDate" />
                        <div class="btn-group btn-group-sm mt-1">
                            @foreach (var days in new[] { 7, 14, 30 })
                            {
                                <button type="button" class="btn btn-outline-secondary" @onclick="() => model.DueDate = model.IssueDate.AddDays(days)">@days dni</button>
                            }
                        </div>
                        <ValidationMessage For="() => model.DueDate" />
                    </div>
                }
                @if (corrected is null && !model.IsProforma)
                {
                    <div class="col-12 col-xl-6">
                        <div class="form-check mt-md-4">
                            <input id="paid" type="checkbox" class="form-check-input" checked="@(model.PaidOn is not null)"
                                   @onchange="e => TogglePaid((bool)e.Value!)" />
                            <label class="form-check-label" for="paid">Zapłacono przy wystawieniu (np. gotówką, kartą lub przedpłatą)</label>
                        </div>
                        @if (model.PaidOn is not null)
                        {
                            <div class="input-group input-group-sm mt-1" style="max-width: 16rem">
                                <span class="input-group-text">Data zapłaty</span>
                                <InputDate id="paid-on" class="form-control" @bind-Value="model.PaidOn" />
                            </div>
                            <div class="form-text">Informacja o zapłacie trafi do KSeF razem z fakturą, a faktura od razu będzie oznaczona jako opłacona.</div>
                        }
                        <ValidationMessage For="() => model.PaidOn" />
                    </div>
                }
                @if (model.PaymentMethod == PaymentMethod.Transfer)
                {
                    <div class="col-12 col-xl-6">
                        <label class="form-label" for="bank">Numer rachunku</label>
                        <InputTextLive id="bank" class="form-control" @bind-Value="model.BankAccountNumber" placeholder="@(companyAccount ?? "")" />
                        <div class="form-text">Puste - zostanie użyty rachunek z danych firmy.</div>
                        <ValidationMessage For="() => model.BankAccountNumber" />
                    </div>
                }
            </div>
        </section>

        @* ---------------- Pozycje ---------------- *@
        <section class="surface form-step" aria-labelledby="step-items">
            <div>
                @if (IsCorrection)
                {
                    <div class="step-head"><span class="step-num">3</span><h2 id="step-items">Stan przed korektą</h2></div>
                    <InvoiceItemsTable Items="before" TestId="items-before" />
                    <h3 class="h6 mt-4">Stan po korekcie</h3>
                    <p class="small text-muted">Zmień pozycje tak, jak powinny wyglądać po korekcie (cena, ilość, stawka). Usunięcie wszystkich pozycji oznacza korektę do zera.</p>
                }
                else
                {
                    <div class="step-head"><span class="step-num">3</span><h2 id="step-items">Pozycje</h2></div>
                }
                <div class="table-responsive">
                    <table class="table align-middle items-table items-grid">
                        <thead>
                            <tr>
                                <th style="width:3rem">Lp.</th>
                                <th>Nazwa towaru lub usługi</th>
                                <th style="width:7rem">J.m.</th>
                                <th style="width:8rem">Ilość</th>
                                <th style="width:10rem">Cena netto</th>
                                <th style="width:10rem">VAT</th>
                                <th class="text-end" style="width:9rem">Netto</th>
                                <th class="text-end" style="width:9rem">Brutto</th>
                                <th style="width:3rem"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var n = 0; n < model.Items.Count; n++)
                            {
                                var item = model.Items[n];
                                var line = n < totals.Lines.Count ? totals.Lines[n] : null;
                                var index = n;
                                <tr>
                                    <td>@(n + 1)</td>
                                    <td data-label="Nazwa towaru lub usługi">
                                        <InputTextLive class="form-control" @bind-Value="item.Name" @bind-Value:after="() => FillFromCatalog(item)"
                                                       list="product-catalog" aria-label="@($"Nazwa pozycji {n + 1}")" />
                                        <ValidationMessage For="() => item.Name" />
                                        @if (!string.IsNullOrWhiteSpace(item.Name) && FindProduct(item.Name) is null)
                                        {
                                            <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => AddToCatalogAsync(item)">zapisz w katalogu</button>
                                        }
                                    </td>
                                    <td data-label="J.m."><InputTextLive class="form-control" @bind-Value="item.Unit" aria-label="Jednostka miary" /></td>
                                    <td data-label="Ilość">
                                        <InputNumber class="form-control" @bind-Value="item.Quantity" @bind-Value:after="Recalculate" step="any" aria-label="Ilość" />
                                        <ValidationMessage For="() => item.Quantity" />
                                    </td>
                                    <td data-label="Cena netto">
                                        <InputNumber class="form-control" @bind-Value="item.UnitNetPrice" @bind-Value:after="Recalculate" step="0.01" aria-label="Cena netto" />
                                        <ValidationMessage For="() => item.UnitNetPrice" />
                                    </td>
                                    <td data-label="VAT">
                                        <InputSelect class="form-select" @bind-Value="item.VatRate" @bind-Value:after="Recalculate" aria-label="Stawka VAT">
                                            @foreach (var rate in VatRateExtensions.Selectable)
                                            {
                                                <option value="@rate">@rate.ToDisplayName()</option>
                                            }
                                        </InputSelect>
                                    </td>
                                    <td class="text-end text-nowrap" data-label="Netto">@(line is null ? "" : Format.Amount(line.NetAmount))</td>
                                    <td class="text-end text-nowrap fw-semibold" data-label="Brutto">@(line is null ? "" : Format.Amount(line.GrossAmount))</td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-outline-danger" title="Usuń pozycję" aria-label="Usuń pozycję"
                                                disabled="@(model.Items.Count == 1 && !IsCorrection)" @onclick="() => RemoveItem(index)"><Icon Name="trash" Size="15" /></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <datalist id="product-catalog">
                    @foreach (var p in products)
                    {
                        <option value="@p.Name">@Format.Amount(p.UnitNetPrice) netto, VAT @p.VatRate.ToDisplayName()</option>
                    }
                </datalist>
                <button type="button" class="btn btn-outline-primary btn-sm mt-2" @onclick="AddItem">+ Dodaj pozycję</button>

                @if (model.Items.Any(i => i.VatRate == VatRate.Exempt))
                {
                    <div class="mt-3 form-narrow">
                        <label class="form-label" for="exemption">Podstawa prawna zwolnienia z VAT</label>
                        <InputTextLive id="exemption" class="form-control" @bind-Value="model.ExemptionBasis" placeholder="np. art. 113 ust. 1 ustawy o VAT" />
                        <div class="form-text">Wymagana na fakturze z pozycjami „zw” (pole P_19A struktury FA(3)).</div>
                        <ValidationMessage For="() => model.ExemptionBasis" />
                    </div>
                }

            </div>
        </section>

            </div>
        <aside class="form-aside">
            <section class="surface p-4" aria-labelledby="summary-h">
                <h2 id="summary-h" class="section-title mb-3">Podsumowanie</h2>
                @* Podsumowanie liczone tym samym kalkulatorem co na serwerze *@
                <div>
                    <div>
                        <table class="table table-sm mb-0 summary-table">
                            <thead><tr><th>Stawka</th><th class="text-end">Netto</th><th class="text-end">VAT</th><th class="text-end">Brutto</th></tr></thead>
                            <tbody>
                                @foreach (var s in totals.ByVatRate)
                                {
                                    <tr>
                                        <td>@s.VatRate.ToDisplayName()</td>
                                        <td class="text-end">@Format.Amount(s.Net)</td>
                                        <td class="text-end">@Format.Amount(s.Vat)</td>
                                        <td class="text-end">@Format.Amount(s.Gross)</td>
                                    </tr>
                                }
                                <tr class="fw-bold">
                                    <td>Razem</td>
                                    <td class="text-end">@Format.Amount(totals.TotalNet)</td>
                                    <td class="text-end">@Format.Amount(totals.TotalVat)</td>
                                    <td class="text-end" data-testid="total-gross">@Format.Money(totals.TotalGross, model.Currency)</td>
                                </tr>
                                @if (correctionTotals is { } ct)
                                {
                                    <tr class="table-warning fw-bold" data-testid="correction-difference">
                                        <td>Różnica (korekta)</td>
                                        <td class="text-end">@Format.Amount(ct.TotalNet)</td>
                                        <td class="text-end">@Format.Amount(ct.TotalVat)</td>
                                        <td class="text-end">@Format.Money(ct.TotalGross, model.Currency)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        @if (Currencies.IsForeign(model.Currency))
                        {
                            <div class="small mt-3" data-testid="exchange-rate">
                                @if (rate is { } r)
                                {
                                    <div>Kurs średni NBP z @Format.Date(r.EffectiveDate) (tabela @r.TableNo): <strong>@r.Rate.ToString("0.0000##", Format.Pl) PLN</strong></div>
                                    <div>Podatek VAT w PLN: <strong>@Format.Money(InvoiceCalculator.VatInPln(totals.ByVatRate, r.Rate).Sum(s => s.Vat))</strong></div>
                                    <div class="text-muted">Kurs z ostatniego dnia roboczego przed dniem sprzedaży; ustalany ponownie przy zapisie.</div>
                                }
                                else if (rateError is not null)
                                {
                                    <div class="text-danger">@rateError</div>
                                }
                                else
                                {
                                    <div class="text-muted">Pobieranie kursu NBP…</div>
                                }
                            </div>
                        }
                    </div>
                </div>
            <div class="d-grid gap-2 mt-4">
                <button type="submit" class="btn btn-primary btn-lg" disabled="@busy"><Icon Name="check" Size="18" Stroke="2.2" /> @(busy ? "Zapisywanie…" : "Zapisz fakturę")</button>
                <a class="btn btn-outline-secondary" href="@(Id is null ? "faktury" : $"faktury/{Id}")">Anuluj</a>
            </div>
            <p class="small muted mt-3 mb-0">@(model.IsProforma ? "Proforma nie trafia do KSeF." : "Po zapisie sprawdzisz fakturę i wyślesz ją do KSeF jednym kliknięciem.")</p>
            </section>
        </aside>
        </div>
    </EditForm>
}

@code {
    [Parameter] public int? Id { get; set; }

    /// <summary>Faktura-wzór dla „Wystaw podobną” (adres /faktury/nowa?wzor=5).</summary>
    [SupplyParameterFromQuery(Name = "wzor")] public int? TemplateId { get; set; }

    /// <summary>Faktura korygowana dla nowej faktury korygującej (adres /faktury/nowa?korekta=5).</summary>
    [SupplyParameterFromQuery(Name = "korekta")] public int? CorrectedId { get; set; }

    /// <summary>Nowa faktura proforma (adres /faktury/nowa?proforma=true) - D42.</summary>
    [SupplyParameterFromQuery(Name = "proforma")] public bool? Proforma { get; set; }

    private InvoiceDto? corrected;
    private IReadOnlyList<InvoiceItemDto> before = [];
    private CorrectionTotals? correctionTotals;
    private bool IsCorrection => model?.CorrectedInvoiceId is not null;

    private string Title => (Id, IsCorrection, model?.IsProforma == true) switch
    {
        (null, true, _) => "Nowa faktura korygująca",
        (null, false, true) => "Nowa faktura proforma",
        (null, false, false) => "Nowa faktura",
        (_, true, _) => $"Edycja korekty {originalNumber}",
        (_, _, true) => $"Edycja proformy {originalNumber}",
        _ => $"Edycja faktury {originalNumber}"
    };

    private SaveInvoiceRequest? model;
    private List<CustomerDto> customers = [];
    private List<ProductDto> products = [];
    private InvoiceTotals totals = InvoiceCalculator.Calculate([]);
    private DeepValidator? validator;
    private ApiProblem? problem;
    private string? suggestedNumber, originalNumber, companyAccount, templateNumber;
    private bool busy, companyMissing;

    private CustomerDto? SelectedCustomer => customers.FirstOrDefault(c => c.Id == model?.CustomerId);

    protected override async Task OnParametersSetAsync()
    {
        var company = await Api.GetAsync<CompanyDto>("api/company");
        if (company.Value is null)
        {
            companyMissing = true;
            return;
        }
        companyAccount = company.Value.BankAccountNumber;
        customers = (await Api.GetAsync<List<CustomerDto>>("api/customers")).Value ?? [];
        products = (await Api.GetAsync<List<ProductDto>>("api/products")).Value ?? [];

        if (Id is null)
        {
            var today = DateOnly.FromDateTime(DateTime.Today);
            model = new SaveInvoiceRequest
            {
                IssueDate = today,
                DueDate = today.AddDays(14),
                Buyer = NewBuyer(),
                Items = [new SaveInvoiceItemRequest()],
                IsProforma = Proforma == true
            };
            templateNumber = null; // przejście z „Wystaw podobną” do pustej „Nowej faktury” (ten sam komponent)
            corrected = null;
            if (TemplateId is not null) await CopyFromTemplateAsync(TemplateId.Value, today);
            if (CorrectedId is not null) await StartCorrectionAsync(CorrectedId.Value, today);
            await SuggestNumberAsync();
        }
        else
        {
            var result = await Api.GetAsync<InvoiceDto>($"api/invoices/{Id}");
            problem = result.Problem;
            if (result.Value is not { } i) return;

            if (i.Status is not (InvoiceStatus.Draft or InvoiceStatus.Rejected))
            {
                Navigation.NavigateTo($"faktury/{Id}");
                return;
            }

            originalNumber = i.Number;
            model = new SaveInvoiceRequest
            {
                Number = i.Number, IssueDate = i.IssueDate, IssuePlace = i.IssuePlace, SaleDate = i.SaleDate,
                Currency = i.Currency, PaymentMethod = i.PaymentMethod, DueDate = i.DueDate, PaidOn = i.PaidOn,
                IsProforma = i.Kind == InvoiceKind.Proforma,
                BankAccountNumber = i.BankAccountNumber, CustomerId = i.CustomerId, Version = i.Version,
                ExemptionBasis = i.ExemptionBasis,
                Buyer = i.CustomerId is null
                    ? new SaveInvoiceBuyerRequest
                    {
                        Name = i.Buyer.Name, Nip = i.Buyer.Nip,
                        Address = new AddressDto { Street = i.Buyer.Address.Street, PostalCode = i.Buyer.Address.PostalCode, City = i.Buyer.Address.City, CountryCode = i.Buyer.Address.CountryCode }
                    }
                    : null,
                Items = i.Items.Select(x => new SaveInvoiceItemRequest
                {
                    Name = x.Name, Unit = x.Unit, Quantity = Trim(x.Quantity), UnitNetPrice = Trim(x.UnitNetPrice), VatRate = x.VatRate
                }).ToList()
            };

            if (i.Correction is { } c)
            {
                model.Buyer = null;
                model.CorrectedInvoiceId = c.CorrectedInvoiceId;
                model.CorrectionReason = c.Reason;
                model.CorrectionType = c.Type;
                before = c.ItemsBefore;
                corrected = (await Api.GetAsync<InvoiceDto>($"api/invoices/{c.CorrectedInvoiceId}")).Value;
            }
        }

        Recalculate();
        await LoadRateAsync();
    }

    private static SaveInvoiceBuyerRequest NewBuyer() => new();

    /// <summary>Usuwa zbędne zera po przecinku (baza przechowuje ilość z 6 miejscami: 10.000000 → 10).</summary>
    private static decimal Trim(decimal value) => value / 1.000000000000000000000000000000000m;

    /// <summary>
    /// Nowa faktura korygująca: stan przed korektą to pozycje faktury albo jej ostatniej przyjętej korekty;
    /// formularz zaczyna od tego stanu, a użytkownik wprowadza zmiany (stan po korekcie).
    /// </summary>
    private async Task StartCorrectionAsync(int correctedId, DateOnly today)
    {
        var result = await Api.GetAsync<InvoiceDto>($"api/invoices/{correctedId}");
        if (result.Value is not { } original)
        {
            problem = result.Problem;
            model = null;
            return;
        }

        corrected = original;
        before = original.Items;
        if (original.Corrections?.LastOrDefault(c => c.Status == InvoiceStatus.Accepted) is { } last
            && (await Api.GetAsync<InvoiceDto>($"api/invoices/{last.Id}")).Value is { } lastCorrection)
            before = lastCorrection.Items;

        model!.CorrectedInvoiceId = original.Id;
        model.CorrectionType = CorrectionType.CorrectionDate;
        model.Buyer = null;
        model.CustomerId = null;
        model.PaymentMethod = original.PaymentMethod;
        model.Currency = original.Currency;
        model.BankAccountNumber = original.BankAccountNumber;
        model.ExemptionBasis = original.ExemptionBasis;
        model.DueDate = null;
        if (today < original.IssueDate) model.IssueDate = original.IssueDate;
        model.Items = before.Select(x => new SaveInvoiceItemRequest
        {
            Name = x.Name, Unit = x.Unit, Quantity = Trim(x.Quantity), UnitNetPrice = Trim(x.UnitNetPrice), VatRate = x.VatRate
        }).ToList();
    }

    /// <summary>
    /// „Wystaw podobną”: nowy szkic z nabywcą, pozycjami i warunkami płatności faktury-wzoru. Numer jest nadawany
    /// od nowa, data wystawienia to dzisiaj, a termin płatności zachowuje odstęp dni z wzoru.
    /// </summary>
    private async Task CopyFromTemplateAsync(int templateId, DateOnly today)
    {
        var result = await Api.GetAsync<InvoiceDto>($"api/invoices/{templateId}");
        if (result.Value is not { } t)
        {
            problem = result.Problem;
            return;
        }

        templateNumber = t.Number;
        model!.IssuePlace = t.IssuePlace;
        model.PaymentMethod = t.PaymentMethod;
        model.Currency = t.Currency;
        model.DueDate = t.DueDate is { } due ? today.AddDays(due.DayNumber - t.IssueDate.DayNumber) : null;
        model.BankAccountNumber = t.BankAccountNumber;
        model.ExemptionBasis = t.ExemptionBasis;

        // Kontrahent z książki adresowej (aktualne dane), a gdy został usunięty - kopia danych nabywcy z wzoru
        if (t.CustomerId is { } customerId && customers.Any(c => c.Id == customerId))
        {
            model.CustomerId = customerId;
            model.Buyer = null;
        }
        else
        {
            model.Buyer = new SaveInvoiceBuyerRequest
            {
                Name = t.Buyer.Name, Nip = t.Buyer.Nip,
                Address = new AddressDto { Street = t.Buyer.Address.Street, PostalCode = t.Buyer.Address.PostalCode, City = t.Buyer.Address.City, CountryCode = t.Buyer.Address.CountryCode }
            };
        }

        model.Items = t.Items.Select(x => new SaveInvoiceItemRequest
        {
            Name = x.Name, Unit = x.Unit, Quantity = Trim(x.Quantity), UnitNetPrice = Trim(x.UnitNetPrice), VatRate = x.VatRate
        }).ToList();
    }

    private async Task SuggestNumberAsync()
    {
        if (Id is not null || model is null) return;
        var kind = IsCorrection ? InvoiceKind.Correction : model.IsProforma ? InvoiceKind.Proforma : InvoiceKind.Vat;
        var result = await Api.GetAsync<NextNumber>($"api/invoices/next-number?issueDate={model.IssueDate:yyyy-MM-dd}&kind={kind}");
        suggestedNumber = result.Value?.Number;
    }

    private void OnCustomerChanged(ChangeEventArgs e)
    {
        model!.CustomerId = int.TryParse(e.Value?.ToString(), out var id) ? id : null;
        model.Buyer = model.CustomerId is null ? NewBuyer() : null;
    }

    private void FillBuyerFromRegistry(VatRegistryEntryDto entry)
    {
        model!.Buyer!.Name = entry.Name;
        VatRegistryLookup.CopyAddress(entry, model.Buyer.Address);
    }

    private void AddItem()
    {
        model!.Items.Add(new SaveInvoiceItemRequest { VatRate = model.Items.LastOrDefault()?.VatRate ?? VatRate.Rate23 });
        Recalculate();
    }

    private void RemoveItem(int index)
    {
        model!.Items.RemoveAt(index);
        Recalculate();
    }

    private ExchangeRateDto? rate;
    private string? rateError;

    private async Task OnDatesChangedAsync()
    {
        await SuggestNumberAsync();
        await LoadRateAsync();
    }

    /// <summary>Podgląd kursu NBP dla waluty obcej (D43) - dzień sprzedaży albo wystawienia.</summary>
    private async Task LoadRateAsync()
    {
        rate = null;
        rateError = null;
        if (model is null || !Currencies.IsForeign(model.Currency)) return;
        var taxPoint = model.SaleDate ?? model.IssueDate;
        var result = await Api.GetAsync<ExchangeRateDto>($"api/exchange-rates/{model.Currency}?date={taxPoint:yyyy-MM-dd}");
        rate = result.Value;
        rateError = result.Problem?.Title;
    }

    private void Recalculate()
    {
        if (model is null) return;
        var after = model!.Items.Select(i => new LineInput(i.Quantity, i.UnitNetPrice, i.VatRate)).ToList();
        totals = InvoiceCalculator.Calculate(after);
        correctionTotals = IsCorrection
            ? InvoiceCalculator.CalculateCorrection(before.Select(b => new LineInput(b.Quantity, b.UnitNetPrice, b.VatRate)), after)
            : null;
    }

    private async Task SaveAsync()
    {
        busy = true;
        var result = Id is null
            ? await Api.PostAsync<InvoiceDto>("api/invoices", model!)
            : await Api.PutAsync<InvoiceDto>($"api/invoices/{Id}", model!);
        busy = false;

        problem = result.Problem;
        if (result.Value is { } saved) Navigation.NavigateTo($"faktury/{saved.Id}");
        else if (problem is not null) validator?.ShowServerErrors(problem);
    }

    private sealed record NextNumber(string Number);

    /// <summary>Zapłata przy wystawieniu (np. gotówka): domyślnie w dniu wystawienia, bez terminu płatności.</summary>
    private void TogglePaid(bool paid)
    {
        model!.PaidOn = paid ? model.IssueDate : null;
        if (paid) model.DueDate = null;
    }

    // ---------------- katalog towarów i usług (D35) ----------------

    private ProductDto? FindProduct(string? name) =>
        string.IsNullOrWhiteSpace(name) ? null : products.FirstOrDefault(p => string.Equals(p.Name, name.Trim(), StringComparison.CurrentCultureIgnoreCase));

    /// <summary>Wybranie nazwy z katalogu (podpowiedź lub pełna nazwa) uzupełnia jednostkę, cenę i stawkę VAT.</summary>
    private void FillFromCatalog(SaveInvoiceItemRequest item)
    {
        if (FindProduct(item.Name) is not { } p) return;
        item.Name = p.Name;
        item.Unit = p.Unit;
        item.UnitNetPrice = p.UnitNetPrice;
        item.VatRate = p.VatRate;
        Recalculate();
    }

    private async Task AddToCatalogAsync(SaveInvoiceItemRequest item)
    {
        var result = await Api.PostAsync<ProductDto>("api/products", new SaveProductRequest
        {
            Name = item.Name.Trim(), Unit = item.Unit, UnitNetPrice = item.UnitNetPrice, VatRate = item.VatRate
        });
        if (result.Value is { } added) products = [.. products, added];
        else problem = result.Problem;
    }

    private async Task SetProformaAsync(bool proforma)
    {
        model!.IsProforma = proforma;
        if (proforma) model.PaidOn = null;
        await SuggestNumberAsync();
    }
}
