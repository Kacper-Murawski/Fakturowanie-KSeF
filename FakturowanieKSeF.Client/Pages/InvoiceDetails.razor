@page "/faktury/{Id:int}"
@inject ApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject CompanyContext Ctx
@implements IDisposable

<PageTitle>Faktura @invoice?.Number - Fakturowanie KSeF</PageTitle>

<ProblemAlert Problem="problem" />

@if (invoice is null)
{
    @if (problem is null)
    {
        <p class="text-muted">Wczytywanie…</p>
    }
}
else
{
    <div class="page-header">
        <div>
            <a class="small fw-semibold d-inline-flex align-items-center gap-1 mb-1" href="faktury"><Icon Name="chevron-left" Size="15" /> Faktury</a>
            <h1 class="mb-2">@(invoice.Kind switch { InvoiceKind.Correction => "Faktura korygująca", InvoiceKind.Proforma => "Faktura proforma", _ => "Faktura VAT" }) @invoice.Number</h1>
            <div class="d-flex flex-wrap align-items-center gap-2">
                @if (invoice.Kind == InvoiceKind.Proforma)
                {
                    <span class="pill pill-info" data-testid="status-badge">Proforma - nie trafia do KSeF</span>
                }
                else
                {
                    <StatusBadge Status="invoice.Status" />
                }
                @if (invoice.Payment is { } pay)
                {
                    <PaymentBadge Status="pay.Status" IsOverdue="pay.IsOverdue" />
                }
                @if (invoice.KsefNumber is not null)
                {
                    <span class="small muted">Numer KSeF: <strong class="text-body" data-testid="ksef-number">@invoice.KsefNumber</strong> · @Format.DateTime(invoice.KsefAcceptedAt)</span>
                }
            </div>
        </div>
        <div class="page-actions">
            @if (Ctx.CanIssue)
            {
                @if (invoice.Kind == InvoiceKind.Proforma)
                {
                    @if (invoice.IssuedFromProforma is null)
                    {
                        <button class="btn btn-primary" @onclick="ConvertAsync" disabled="@busy" title="Szkic faktury VAT z nabywcą i pozycjami proformy"><Icon Name="file" Size="17" /> Wystaw fakturę VAT</button>
                    }
                    <a class="btn btn-outline-secondary" href="faktury/@invoice.Id/edycja"><Icon Name="edit" Size="16" /> Edytuj</a>
                    <button class="btn btn-outline-danger" @onclick="DeleteAsync" disabled="@busy" aria-label="Usuń"><Icon Name="trash" Size="16" /> Usuń</button>
                }
                else if (invoice.Status is InvoiceStatus.Draft or InvoiceStatus.Rejected)
                {
                    <button class="btn btn-primary" @onclick="SendAsync" disabled="@busy"><Icon Name="send" Size="17" /> @(busy ? "Wysyłanie…" : "Wyślij do KSeF")</button>
                    <a class="btn btn-outline-secondary" href="faktury/@invoice.Id/edycja"><Icon Name="edit" Size="16" /> Edytuj</a>
                    <button class="btn btn-outline-danger" @onclick="DeleteAsync" disabled="@busy" aria-label="Usuń"><Icon Name="trash" Size="16" /> Usuń</button>
                }
            }
        </div>
    </div>

    <div class="form-layout">
    <div class="form-main">
    @if (invoice.Origin == InvoiceOrigin.KsefImport)
    {
        <div class="alert alert-light border small" data-testid="imported-info">
            Faktura wystawiona poza aplikacją (np. w innym programie) i pobrana z KSeF - tylko do odczytu. Możesz rejestrować
            wpłaty, wysłać ją e-mailem i wystawić do niej korektę.
        </div>
    }

    @if (invoice.Kind == InvoiceKind.Proforma)
    {
        <div class="alert alert-secondary small" data-testid="proforma-links">
            Faktura proforma nie jest fakturą VAT - nie jest wysyłana do KSeF i nie podlega rozliczeniu.
            @if (invoice.IssuedFromProforma is { } vat)
            {
                <span>Na jej podstawie wystawiono fakturę <a href="faktury/@vat.Id">@vat.Number</a>.</span>
            }
            else
            {
                <span>Po zapłacie lub realizacji zamówienia wybierz <strong>Wystaw fakturę VAT</strong>.</span>
            }
        </div>
    }
    else if (invoice.Proforma is { } source)
    {
        <div class="alert alert-light border small" data-testid="proforma-source">Wystawiona na podstawie proformy <a href="faktury/@source.Id">@source.Number</a>.</div>
    }

    @switch (invoice.Kind == InvoiceKind.Proforma ? (InvoiceStatus?)null : invoice.Status)
    {
        case InvoiceStatus.Draft:
            <div class="alert alert-info small">
                To jest szkic - można go jeszcze zmienić. Po wysłaniu do KSeF i nadaniu numeru KSeF faktura staje się dokumentem
                ostatecznym i nie można jej edytować.
            </div>
            break;

        case InvoiceStatus.Pending:
            <div class="alert alert-warning d-flex align-items-center gap-2" role="status">
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                <span>
                    Faktura przekazana do KSeF - oczekiwanie na przetworzenie. Strona odświeży się automatycznie.
                    @if (invoice.LastSubmission is { FailedAttempts: > 0 } pending)
                    {
                        <br /><small>Problemy z połączeniem z KSeF (@pending.FailedAttempts): @pending.LastError. Aplikacja ponawia próby.</small>
                    }
                </span>
            </div>
            break;

        case InvoiceStatus.Accepted when invoice.LastSubmission is { } ok:
            <div class="alert alert-success small">
                Faktura przyjęta w KSeF (testowym) - numer KSeF <strong>@invoice.KsefNumber</strong>, nadany @Format.DateTime(ok.KsefAssignedAt).
                @(ok.HasUpo ? "Urzędowe poświadczenie odbioru (UPO) jest dostępne do pobrania." : "UPO zostanie pobrane automatycznie, gdy KSeF je wygeneruje.")
            </div>
            break;

        case InvoiceStatus.Rejected when invoice.LastSubmission is { } bad:
            <div class="alert alert-danger">
                <strong>KSeF nie przyjął faktury</strong>@(bad.StatusCode is { } code ? $" (kod {code})" : ""): @bad.StatusDescription
                @if (bad.StatusDetails.Count > 0)
                {
                    <ul class="mb-0 mt-1">
                        @foreach (var d in bad.StatusDetails)
                        {
                            <li>@d</li>
                        }
                    </ul>
                }
                <div class="small mt-1">Popraw fakturę i wyślij ją ponownie.</div>
            </div>
            break;
    }

    @if (invoice.Correction is { } correction)
    {
        <div class="alert alert-secondary" data-testid="correction-info">
            Korekta faktury <a href="faktury/@correction.CorrectedInvoiceId"><strong>@correction.CorrectedInvoiceNumber</strong></a>
            z dnia @Format.Date(correction.CorrectedInvoiceIssueDate)@(correction.CorrectedInvoiceKsefNumber is null ? "" : $", numer KSeF {correction.CorrectedInvoiceKsefNumber}").
            <br />Przyczyna: <strong>@correction.Reason</strong>
            @if (correction.Type is { } type)
            {
                <br /><span class="small">@Format.CorrectionType(type)</span>
            }
            <br /><span class="small">Brutto przed korektą @Format.Money(correction.BeforeGross, invoice.Currency), po korekcie @Format.Money(correction.AfterGross, invoice.Currency).</span>
        </div>
    }

    <div class="invoice-sheet surface">
        <div class="sheet-body">
            <div class="sheet-head">
                <div>
                    <div class="sheet-kind">@(invoice.Kind switch { InvoiceKind.Correction => "Faktura korygująca", InvoiceKind.Proforma => "Faktura proforma", _ => "Faktura VAT" })</div>
                    <div class="sheet-number">@invoice.Number</div>
                </div>
                <dl class="sheet-dates">
                    <dt>Data wystawienia</dt><dd>@Format.Date(invoice.IssueDate)@(invoice.IssuePlace is null ? "" : $", {invoice.IssuePlace}")</dd>
                    <dt>Data sprzedaży</dt><dd>@Format.Date(invoice.SaleDate ?? invoice.IssueDate)</dd>
                    @if (invoice.DueDate is not null)
                    {
                        <dt>Termin płatności</dt><dd>@Format.Date(invoice.DueDate)</dd>
                    }
                </dl>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-sm-6">
                    <div class="sheet-party">
                    <h2 class="sheet-label">Sprzedawca</h2>
                    <Party Data="invoice.Seller" />
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="sheet-party">
                    <h2 class="sheet-label">Nabywca</h2>
                    <Party Data="invoice.Buyer" />
                    </div>
                </div>
            </div>

            @if (invoice.Correction is { } k)
            {
                <h2 class="sheet-label">Stan przed korektą</h2>
                <InvoiceItemsTable Items="k.ItemsBefore" TestId="items-before" />
                <h2 class="sheet-label mt-3">Stan po korekcie</h2>
                <InvoiceItemsTable Items="invoice.Items" TestId="items-after" />
            }
            else
            {
                <InvoiceItemsTable Items="invoice.Items" />
            }

            <div class="row justify-content-end mt-3">
                <div class="col-md-7 col-xl-6">
                    <table class="table table-sm summary-table">
                        <thead><tr><th>Stawka</th><th class="text-end">Netto</th><th class="text-end">VAT</th><th class="text-end">Brutto</th></tr></thead>
                        <tbody>
                            @foreach (var s in invoice.VatSummary)
                            {
                                <tr>
                                    <td>@s.VatRate.ToDisplayName()</td>
                                    <td class="text-end">@Format.Amount(s.Net)</td>
                                    <td class="text-end">@Format.Amount(s.Vat)</td>
                                    <td class="text-end">@Format.Amount(s.Gross)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (invoice.Kind == InvoiceKind.Correction)
                    {
                        <p class="small text-muted text-end mb-1">Różnica: stan po korekcie - stan przed korektą</p>
                        <p class="fs-5 text-end" data-testid="correction-total">
                            @(invoice.TotalGross < 0 ? "Do zwrotu" : "Do dopłaty"): <strong>@Format.Money(Math.Abs(invoice.TotalGross), invoice.Currency)</strong>
                        </p>
                    }
                    else
                    {
                        <p class="fs-5 text-end sheet-total">Do zapłaty: <strong>@Format.Money(invoice.TotalGross, invoice.Currency)</strong></p>
                    }
                    @if (invoice.ExchangeRate is { } rate)
                    {
                        <div class="small text-end" data-testid="exchange-rate">
                            Podatek VAT w PLN: <strong>@Format.Money(invoice.VatSummaryPln?.Sum(s => s.Vat) ?? 0)</strong><br />
                            Kurs średni NBP @rate.Currency z @Format.Date(rate.EffectiveDate) (tabela @rate.TableNo):
                            @rate.Rate.ToString("0.0000##", Format.Pl) PLN
                        </div>
                    }
                </div>
            </div>

            <div class="small sheet-payment">
                Forma płatności: <strong>@Format.Payment(invoice.PaymentMethod)</strong>
                @if (invoice.PaidOn is not null)
                {
                    <span>, <strong class="text-success" data-testid="paid-at-issue">zapłacono @Format.Date(invoice.PaidOn)</strong></span>
                }
                @if (invoice.DueDate is not null)
                {
                    <span>, termin: <strong>@Format.Date(invoice.DueDate)</strong></span>
                }
                @if (invoice.BankAccountNumber is not null)
                {
                    <br /><span>Rachunek: <strong>@Format.BankAccount(invoice.BankAccountNumber)</strong></span>
                }
                @if (invoice.ExemptionBasis is not null)
                {
                    <br /><span>Podstawa zwolnienia z VAT: <strong>@invoice.ExemptionBasis</strong></span>
                }
            </div>
        </div>
    </div>
    </div>
    <aside class="form-aside">
    @if (invoice.Corrections is { Count: > 0 } corrections)
    {
        <section class="surface p-4" data-testid="corrections">
            <div>
                <h2 class="section-title mb-2">Faktury korygujące</h2>
                <ul class="mb-0">
                    @foreach (var c in corrections)
                    {
                        <li>
                            <a href="faktury/@c.Id">@c.Number</a> z dnia @Format.Date(c.IssueDate):
                            @Format.Money(c.TotalGross, invoice.Currency) <StatusBadge Status="c.Status" />
                        </li>
                    }
                </ul>
            </div>
        </section>
    }

    @if (invoice.Payment is { } payment)
    {
        <PaymentPanel InvoiceUrl="@($"api/invoices/{invoice.Id}")" Info="payment" TotalGross="invoice.TotalGross"
                      Currency="@invoice.Currency" DueDate="invoice.DueDate"
                      InfoChanged="info => invoice = invoice with { Payment = info }" />
    }

    @if (Ctx.CanIssue && (invoice.Status == InvoiceStatus.Accepted || invoice.Kind == InvoiceKind.Proforma))
    {
        <InvoiceEmailPanel InvoiceId="invoice.Id" Remaining="invoice.Payment?.Remaining" />
    }

    <section class="surface p-4" aria-labelledby="docs-h">
        <h2 id="docs-h" class="section-title mb-3">Dokumenty i dalsze kroki</h2>
        <div class="d-grid gap-2">
            <a class="btn btn-outline-secondary justify-content-start" href="api/invoices/@invoice.Id/pdf" download><Icon Name="printer" Size="16" /> Pobierz PDF</a>
            @if (invoice.Kind != InvoiceKind.Proforma)
            {
                <a class="btn btn-outline-secondary justify-content-start" href="api/invoices/@invoice.Id/xml" download title="XML w strukturze FA(3), w postaci wysyłanej do KSeF"><Icon Name="file" Size="16" /> Pobierz XML (FA(3))</a>
            }
            @if (invoice.LastSubmission?.HasUpo == true)
            {
                <a class="btn btn-outline-success justify-content-start" href="api/invoices/@invoice.Id/upo" download><Icon Name="shield" Size="16" /> Pobierz UPO</a>
            }
            @if (Ctx.CanIssue)
            {
                @if (invoice is { Kind: InvoiceKind.Vat, Status: InvoiceStatus.Accepted })
                {
                    <a class="btn btn-outline-secondary justify-content-start" href="faktury/nowa?korekta=@invoice.Id" title="Faktura korygująca (KOR) do tej faktury"><Icon Name="edit" Size="16" /> Wystaw korektę</a>
                }
                @if (invoice.Kind == InvoiceKind.Vat)
                {
                    <a class="btn btn-outline-secondary justify-content-start" href="faktury/nowa?wzor=@invoice.Id" title="Nowy szkic z tym samym nabywcą i pozycjami"><Icon Name="copy" Size="16" /> Wystaw podobną</a>
                    <a class="btn btn-outline-secondary justify-content-start" href="cykliczne/nowa?wzor=@invoice.Id" title="Szkice tej faktury co miesiąc, kwartał lub rok"><Icon Name="repeat" Size="16" /> Ustaw jako cykliczną</a>
                }
            }
        </div>
    </section>
    </aside>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private InvoiceDto? invoice;
    private ApiProblem? problem;
    private bool busy;

    private Timer? refreshTimer;

    protected override async Task OnParametersSetAsync()
    {
        await Ctx.EnsureLoadedAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<InvoiceDto>($"api/invoices/{Id}");
        invoice = result.Value;
        problem = result.Problem;
        ScheduleRefresh();
    }

    /// <summary>Dopóki KSeF przetwarza fakturę (lub nie ma jeszcze UPO) - odświeżanie co 3 s.</summary>
    private void ScheduleRefresh()
    {
        var waiting = invoice is { Status: InvoiceStatus.Pending } or { Status: InvoiceStatus.Accepted, LastSubmission.HasUpo: false };
        refreshTimer?.Dispose();
        refreshTimer = waiting
            ? new Timer(_ => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); }), null, TimeSpan.FromSeconds(3), Timeout.InfiniteTimeSpan)
            : null;
    }

    private async Task SendAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Wysłać fakturę {invoice!.Number} do KSeF (środowisko testowe)? Po przyjęciu nie będzie można jej zmienić.")) return;

        busy = true;
        var result = await Api.PostAsync<InvoiceDto>($"api/invoices/{Id}/send", new SendInvoiceRequest { Version = invoice.Version });
        busy = false;

        problem = result.Problem;
        if (result.Value is { } sent)
        {
            invoice = sent;
            ScheduleRefresh();
        }
    }

    public void Dispose() => refreshTimer?.Dispose();

    private async Task DeleteAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Usunąć fakturę {invoice!.Number}?")) return;

        busy = true;
        var result = await Api.DeleteAsync($"api/invoices/{Id}");
        busy = false;
        problem = result.Problem;
        if (problem is null) Navigation.NavigateTo("faktury");
    }

    /// <summary>Szkic faktury VAT na podstawie proformy (D42) - przejście do jego edycji.</summary>
    private async Task ConvertAsync()
    {
        busy = true;
        var result = await Api.PostAsync<InvoiceDto>($"api/invoices/{invoice!.Id}/convert", new { });
        busy = false;
        problem = result.Problem;
        if (result.Value is { } vat) Navigation.NavigateTo($"faktury/{vat.Id}/edycja");
    }
}
