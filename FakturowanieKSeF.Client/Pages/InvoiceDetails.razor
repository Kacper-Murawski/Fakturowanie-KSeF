@page "/faktury/{Id:int}"
@inject ApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Faktura @invoice?.Number - Fakturowanie KSeF</PageTitle>

<ProblemAlert Problem="problem" />

@if (invoice is null)
{
    @if (problem is null)
    {
        <p class="text-muted">Wczytywanie…</p>
    }
}
else
{
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
        <div>
            <h1 class="mb-1">Faktura VAT @invoice.Number</h1>
            <StatusBadge Status="invoice.Status" />
            @if (invoice.KsefNumber is not null)
            {
                <span class="ms-2 small">Numer KSeF: <strong>@invoice.KsefNumber</strong> (@Format.DateTime(invoice.KsefAcceptedAt))</span>
            }
        </div>
        <div class="d-flex flex-wrap gap-2">
            @if (invoice.Status is InvoiceStatus.Draft or InvoiceStatus.Rejected)
            {
                <button class="btn btn-success" @onclick="SendAsync" disabled="@busy">@(busy ? "Wysyłanie…" : "Wyślij do KSeF")</button>
                <a class="btn btn-primary" href="faktury/@invoice.Id/edycja">Edytuj</a>
                <button class="btn btn-outline-danger" @onclick="DeleteAsync" disabled="@busy">Usuń</button>
            }
            @if (invoice.LastSubmission?.HasUpo == true)
            {
                <a class="btn btn-outline-success" href="api/invoices/@invoice.Id/upo" download>Pobierz UPO</a>
            }
            <a class="btn btn-outline-secondary" href="api/invoices/@invoice.Id/pdf" download>Pobierz PDF</a>
            <a class="btn btn-outline-secondary" href="api/invoices/@invoice.Id/xml" download title="XML w strukturze FA(3), w postaci wysyłanej do KSeF">Pobierz XML (FA(3))</a>
            <a class="btn btn-outline-secondary" href="faktury">Wróć do listy</a>
        </div>
    </div>

    @switch (invoice.Status)
    {
        case InvoiceStatus.Draft:
            <div class="alert alert-info small">
                To jest szkic - można go jeszcze zmienić. Po wysłaniu do KSeF i nadaniu numeru KSeF faktura staje się dokumentem
                ostatecznym i nie można jej edytować.
            </div>
            break;

        case InvoiceStatus.Pending:
            <div class="alert alert-warning d-flex align-items-center gap-2" role="status">
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                <span>
                    Faktura przekazana do KSeF - oczekiwanie na przetworzenie. Strona odświeży się automatycznie.
                    @if (invoice.LastSubmission is { FailedAttempts: > 0 } pending)
                    {
                        <br /><small>Problemy z połączeniem z KSeF (@pending.FailedAttempts): @pending.LastError. Aplikacja ponawia próby.</small>
                    }
                </span>
            </div>
            break;

        case InvoiceStatus.Accepted when invoice.LastSubmission is { } ok:
            <div class="alert alert-success small">
                Faktura przyjęta w KSeF (testowym) - numer KSeF <strong>@invoice.KsefNumber</strong>, nadany @Format.DateTime(ok.KsefAssignedAt).
                @(ok.HasUpo ? "Urzędowe poświadczenie odbioru (UPO) jest dostępne do pobrania." : "UPO zostanie pobrane automatycznie, gdy KSeF je wygeneruje.")
            </div>
            break;

        case InvoiceStatus.Rejected when invoice.LastSubmission is { } bad:
            <div class="alert alert-danger">
                <strong>KSeF nie przyjął faktury</strong>@(bad.StatusCode is { } code ? $" (kod {code})" : ""): @bad.StatusDescription
                @if (bad.StatusDetails.Count > 0)
                {
                    <ul class="mb-0 mt-1">
                        @foreach (var d in bad.StatusDetails)
                        {
                            <li>@d</li>
                        }
                    </ul>
                }
                <div class="small mt-1">Popraw fakturę i wyślij ją ponownie.</div>
            </div>
            break;
    }

    @if (invoice.Payment is { } payment)
    {
        <PaymentPanel InvoiceUrl="@($"api/invoices/{invoice.Id}")" Info="payment" TotalGross="invoice.TotalGross"
                      Currency="@invoice.Currency" DueDate="invoice.DueDate"
                      InfoChanged="info => invoice = invoice with { Payment = info }" />
    }

    <div class="invoice-sheet card">
        <div class="card-body">
            <div class="row mb-4">
                <div class="col-sm-6 small">
                    Data wystawienia: <strong>@Format.Date(invoice.IssueDate)</strong>@(invoice.IssuePlace is null ? "" : $", {invoice.IssuePlace}")<br />
                    Data sprzedaży: <strong>@Format.Date(invoice.SaleDate ?? invoice.IssueDate)</strong>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-sm-6">
                    <h2 class="h6 text-muted text-uppercase">Sprzedawca</h2>
                    <Party Data="invoice.Seller" />
                </div>
                <div class="col-sm-6">
                    <h2 class="h6 text-muted text-uppercase">Nabywca</h2>
                    <Party Data="invoice.Buyer" />
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Lp.</th><th>Nazwa</th><th>J.m.</th><th class="text-end">Ilość</th><th class="text-end">Cena netto</th>
                            <th class="text-end">Wartość netto</th><th>VAT</th><th class="text-end">Wartość brutto</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var i in invoice.Items)
                        {
                            <tr>
                                <td>@i.Position</td>
                                <td>@i.Name</td>
                                <td>@i.Unit</td>
                                <td class="text-end">@Format.Quantity(i.Quantity)</td>
                                <td class="text-end">@Format.Amount(i.UnitNetPrice)</td>
                                <td class="text-end">@Format.Amount(i.NetAmount)</td>
                                <td>@i.VatRate.ToDisplayName()</td>
                                <td class="text-end">@Format.Amount(i.GrossAmount)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="row justify-content-end">
                <div class="col-md-6">
                    <table class="table table-sm">
                        <thead><tr><th>Stawka</th><th class="text-end">Netto</th><th class="text-end">VAT</th><th class="text-end">Brutto</th></tr></thead>
                        <tbody>
                            @foreach (var s in invoice.VatSummary)
                            {
                                <tr>
                                    <td>@s.VatRate.ToDisplayName()</td>
                                    <td class="text-end">@Format.Amount(s.Net)</td>
                                    <td class="text-end">@Format.Amount(s.Vat)</td>
                                    <td class="text-end">@Format.Amount(s.Gross)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <p class="fs-5 text-end">Do zapłaty: <strong>@Format.Money(invoice.TotalGross, invoice.Currency)</strong></p>
                </div>
            </div>

            <div class="small">
                Forma płatności: <strong>@Format.Payment(invoice.PaymentMethod)</strong>
                @if (invoice.DueDate is not null)
                {
                    <span>, termin: <strong>@Format.Date(invoice.DueDate)</strong></span>
                }
                @if (invoice.BankAccountNumber is not null)
                {
                    <br /><span>Rachunek: <strong>@Format.BankAccount(invoice.BankAccountNumber)</strong></span>
                }
                @if (invoice.ExemptionBasis is not null)
                {
                    <br /><span>Podstawa zwolnienia z VAT: <strong>@invoice.ExemptionBasis</strong></span>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private InvoiceDto? invoice;
    private ApiProblem? problem;
    private bool busy;

    private Timer? refreshTimer;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<InvoiceDto>($"api/invoices/{Id}");
        invoice = result.Value;
        problem = result.Problem;
        ScheduleRefresh();
    }

    /// <summary>Dopóki KSeF przetwarza fakturę (lub nie ma jeszcze UPO) - odświeżanie co 3 s.</summary>
    private void ScheduleRefresh()
    {
        var waiting = invoice is { Status: InvoiceStatus.Pending } or { Status: InvoiceStatus.Accepted, LastSubmission.HasUpo: false };
        refreshTimer?.Dispose();
        refreshTimer = waiting
            ? new Timer(_ => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); }), null, TimeSpan.FromSeconds(3), Timeout.InfiniteTimeSpan)
            : null;
    }

    private async Task SendAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Wysłać fakturę {invoice!.Number} do KSeF (środowisko testowe)? Po przyjęciu nie będzie można jej zmienić.")) return;

        busy = true;
        var result = await Api.PostAsync<InvoiceDto>($"api/invoices/{Id}/send", new SendInvoiceRequest { Version = invoice.Version });
        busy = false;

        problem = result.Problem;
        if (result.Value is { } sent)
        {
            invoice = sent;
            ScheduleRefresh();
        }
    }

    public void Dispose() => refreshTimer?.Dispose();

    private async Task DeleteAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Usunąć fakturę {invoice!.Number}?")) return;

        busy = true;
        var result = await Api.DeleteAsync($"api/invoices/{Id}");
        busy = false;
        problem = result.Problem;
        if (problem is null) Navigation.NavigateTo("faktury");
    }
}
