@page "/"
@inject ApiClient Api

<PageTitle>Pulpit - Fakturowanie KSeF</PageTitle>

<h1>Pulpit</h1>

@if (loading)
{
    <p class="text-muted">Wczytywanie…</p>
}
else if (company is null)
{
    <div class="card border-primary">
        <div class="card-body">
            <h2 class="h5">Witaj! Zacznij od danych swojej firmy</h2>
            <p class="mb-3">Dane firmy (nazwa, NIP, adres) pojawią się jako sprzedawca na każdej wystawianej fakturze.</p>
            <a class="btn btn-primary" href="firma">Uzupełnij dane firmy</a>
        </div>
    </div>
}
else
{
    <p class="text-muted">@company.Name, NIP @Format.Nip(company.Nip)</p>

    <div class="row g-3 mb-4">
        @foreach (var (label, status, count) in counters)
        {
            <div class="col-sm-6 col-lg-3">
                <a class="card text-decoration-none h-100" href="faktury?status=@status">
                    <div class="card-body">
                        <div class="text-muted small">@label</div>
                        <div class="fs-3 fw-semibold">@count</div>
                    </div>
                </a>
            </div>
        }
    </div>

    @if (payments is { } s)
    {
        <div class="row g-3 mb-4" data-testid="payments-summary">
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="h6 text-muted">Należności (do zapłaty przez nabywców)</h2>
                        <a class="fs-4 fw-semibold text-decoration-none" href="faktury?payment=Unpaid" data-testid="receivables">@Format.Money(s.ReceivablesTotal)</a>
                        <div class="small text-muted">@s.ReceivablesCount @Faktur(s.ReceivablesCount)</div>
                        @if (s.ReceivablesOverdueCount > 0)
                        {
                            <a class="d-block mt-2 text-danger fw-semibold" href="faktury?payment=Overdue">
                                Po terminie: @Format.Money(s.ReceivablesOverdue) (@s.ReceivablesOverdueCount @Faktur(s.ReceivablesOverdueCount))
                            </a>
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="h6 text-muted">Zobowiązania (faktury otrzymane do zapłaty)</h2>
                        <a class="fs-4 fw-semibold text-decoration-none" href="faktury-otrzymane?payment=Unpaid" data-testid="payables">@Format.Money(s.PayablesTotal)</a>
                        <div class="small text-muted">@s.PayablesCount @Faktur(s.PayablesCount)</div>
                        @if (s.PayablesOverdueCount > 0)
                        {
                            <a class="d-block mt-2 text-danger fw-semibold" href="faktury-otrzymane?payment=Overdue">
                                Po terminie: @Format.Money(s.PayablesOverdue) (@s.PayablesOverdueCount @Faktur(s.PayablesOverdueCount))
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    @if (dashboard is { } d)
    {
        <div class="row g-3 mb-4">
            <div class="col-lg-8">
                <section class="card h-100">
                    <div class="card-body">
                        <h2 class="h6 mb-1">Sprzedaż i koszty netto - ostatnie 12 miesięcy</h2>
                        <p class="small text-muted mb-2">Sprzedaż: faktury przekazane do KSeF (z korektami). Koszty: faktury otrzymane z KSeF. Kwoty w PLN.</p>
                        <MonthlyChart Months="d.Months" />
                    </div>
                </section>
            </div>
            <div class="col-lg-4 d-flex flex-column gap-3">
                <section class="card">
                    <div class="card-body">
                        <h2 class="h6">Należności według terminu</h2>
                        <BarList TestId="aging" Items="@(d.ReceivablesAging.Select(a => new BarList.Item(a.Label, a.Amount,
                            a.Count == 0 ? null : $"{a.Count} {Faktur(a.Count)}")).ToList())" />
                    </div>
                </section>
                <section class="card">
                    <div class="card-body">
                        <h2 class="h6">Najwięksi nabywcy (12 miesięcy, netto)</h2>
                        @if (d.TopCustomers.Count == 0)
                        {
                            <p class="small text-muted mb-0">Brak sprzedaży w tym okresie.</p>
                        }
                        else
                        {
                            <BarList TestId="top-customers" Items="@(d.TopCustomers.Select(c => new BarList.Item(c.Name, c.SalesNet,
                                $"{c.Count} {Faktur(c.Count)}", $"faktury?q={Uri.EscapeDataString(c.Nip ?? c.Name)}")).ToList())" />
                        }
                    </div>
                </section>
            </div>
        </div>
    }

    <div class="d-flex gap-2">
        <a class="btn btn-primary" href="faktury/nowa">Wystaw fakturę</a>
        <a class="btn btn-outline-secondary" href="kontrahenci/nowy">Dodaj kontrahenta</a>
    </div>
}

@code {
    private bool loading = true;
    private CompanyDto? company;
    private PaymentsSummaryDto? payments;
    private DashboardDto? dashboard;
    private List<(string label, InvoiceStatus status, int count)> counters = [];

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetAsync<CompanyDto>("api/company");
        company = result.Value;

        if (company is not null)
        {
            (string, InvoiceStatus)[] statuses =
            [
                ("Szkice", InvoiceStatus.Draft),
                ("Oczekujące w KSeF", InvoiceStatus.Pending),
                ("Przyjęte w KSeF", InvoiceStatus.Accepted),
                ("Odrzucone", InvoiceStatus.Rejected)
            ];
            foreach (var (label, status) in statuses)
            {
                var page = await Api.GetAsync<PagedResult<InvoiceListItemDto>>($"api/invoices?status={status}&pageSize=1");
                counters.Add((label, status, page.Value?.TotalCount ?? 0));
            }
            payments = (await Api.GetAsync<PaymentsSummaryDto>("api/payments/summary")).Value;
            dashboard = (await Api.GetAsync<DashboardDto>("api/dashboard")).Value;
        }

        loading = false;
    }

    /// <summary>Polska odmiana: 1 faktura, 2-4 faktury, 5+ faktur (12-14 faktur).</summary>
    private static string Faktur(int n) =>
        n == 1 ? "faktura" : n % 10 is >= 2 and <= 4 && n % 100 is < 12 or > 14 ? "faktury" : "faktur";
}
