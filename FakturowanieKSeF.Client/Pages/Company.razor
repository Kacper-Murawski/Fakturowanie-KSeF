@page "/firma"
@inject ApiClient Api
@inject CompanyContext Ctx

<PageTitle>Moja firma - Fakturowanie KSeF</PageTitle>

<div class="page-header">
    <div>
        <h1>Moja firma</h1>
        <p class="page-subtitle">Dane sprzedawcy na fakturach, połączenie z KSeF, powiadomienia i dostęp dla księgowej lub pracowników.</p>
    </div>
</div>

@if (model is null)
{
    <p class="text-muted">Wczytywanie…</p>
}
else if (companyExists && !Ctx.IsOwner)
{
    <div class="surface form-card form-narrow" data-testid="company-readonly">
        <div>
            <p class="mb-1"><strong>@model.Name</strong>, NIP @Format.Nip(model.Nip)</p>
            <p class="mb-1">@model.Address.Street, @model.Address.PostalCode @model.Address.City</p>
            <p class="small text-muted mb-0">
                Masz dostęp do tej firmy z rolą <strong>@CompanyContext.RoleName(Ctx.Role)</strong>. Dane firmy, token KSeF, powiadomienia
                i użytkowników zmienia właściciel.
            </p>
        </div>
    </div>
}
else
{
    <EditForm Model="model" OnValidSubmit="SaveAsync" FormName="company" class="surface form-card form-narrow">
        <div class="step-head"><span class="step-num"><Icon Name="building" Size="17" /></span><h2>Dane firmy</h2></div>
        <DeepValidator @ref="validator" />
        <ProblemAlert Problem="problem" />
        @if (saved)
        {
            <div class="alert alert-success" role="status">Zapisano dane firmy.</div>
        }

        <div class="mb-3">
            <label class="form-label" for="name">Nazwa firmy</label>
            <InputTextLive id="name" class="form-control" @bind-Value="model.Name" />
            <ValidationMessage For="() => model.Name" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="nip">NIP</label>
            <VatRegistryLookup Nip="@model.Nip" OnFound="FillFromRegistry" Revalidate="[model, model.Address]">
                <InputTextLive id="nip" class="form-control" @bind-Value="model.Nip" placeholder="1234567890" />
            </VatRegistryLookup>
            <ValidationMessage For="() => model.Nip" />
        </div>

        <fieldset class="mb-3">
            <legend class="form-label">Adres</legend>
            <AddressFields Address="model.Address" IdPrefix="company" />
        </fieldset>

        <div class="row g-2 mb-3">
            <div class="col-sm-6">
                <label class="form-label" for="email">E-mail</label>
                <InputTextLive id="email" class="form-control" @bind-Value="model.Email" />
                <ValidationMessage For="() => model.Email" />
            </div>
            <div class="col-sm-6">
                <label class="form-label" for="phone">Telefon</label>
                <InputTextLive id="phone" class="form-control" @bind-Value="model.Phone" />
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label" for="bank">Numer rachunku bankowego</label>
            <InputTextLive id="bank" class="form-control" @bind-Value="model.BankAccountNumber" placeholder="00 0000 0000 0000 0000 0000 0000" />
            <div class="form-text">Podpowiadany na fakturach płatnych przelewem.</div>
            <ValidationMessage For="() => model.BankAccountNumber" />
        </div>

        <button type="submit" class="btn btn-primary" disabled="@busy"><Icon Name="check" Size="17" Stroke="2.2" /> Zapisz</button>
    </EditForm>

    @if (companyExists)
    {
        <KsefSettings />
        <NotificationSettings />
        <CompanyMembers />
    }
}

@code {
    private SaveCompanyRequest? model;
    private DeepValidator? validator;
    private ApiProblem? problem;
    private bool busy, saved, companyExists;

    protected override async Task OnInitializedAsync()
    {
        await Ctx.EnsureLoadedAsync();
        var result = await Api.GetAsync<CompanyDto>("api/company");
        companyExists = result.Value is not null;
        model = result.Value is { } c
            ? new SaveCompanyRequest
            {
                Name = c.Name, Nip = c.Nip, Email = c.Email, Phone = c.Phone, BankAccountNumber = c.BankAccountNumber,
                Address = new AddressDto { Street = c.Address.Street, PostalCode = c.Address.PostalCode, City = c.Address.City, CountryCode = c.Address.CountryCode }
            }
            : new SaveCompanyRequest();
    }

    private void FillFromRegistry(VatRegistryEntryDto entry)
    {
        model!.Name = entry.Name;
        VatRegistryLookup.CopyAddress(entry, model.Address);
        // Rachunek z wykazu tylko jako podpowiedź, gdy użytkownik nie wpisał własnego
        if (string.IsNullOrWhiteSpace(model.BankAccountNumber) && entry.BankAccounts.Count > 0)
            model.BankAccountNumber = Format.BankAccount(entry.BankAccounts[0]);
    }

    private async Task SaveAsync()
    {
        busy = true;
        saved = false;
        var result = await Api.PutAsync<CompanyDto>("api/company", model!);
        problem = result.Problem;
        if (problem is not null) validator?.ShowServerErrors(problem);
        else
        {
            saved = true;
            if (!companyExists)
            {
                companyExists = true;
                Ctx.Reset(); // nowa firma - odświeżenie listy firm i roli
                await Ctx.EnsureLoadedAsync();
            }
        }
        busy = false;
    }
}
