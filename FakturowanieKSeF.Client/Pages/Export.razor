@page "/eksport"
@using System.Globalization
@inject ApiClient Api

<PageTitle>Eksport dla księgowej - Fakturowanie KSeF</PageTitle>

<div class="page-header">
    <div>
        <h1>Eksport dla księgowej</h1>
        <p class="page-subtitle">
            Zestawienia faktur za wybrany okres (CSV do Excela lub programu księgowego) oraz paczka ZIP z plikami XML
            faktur w postaci z KSeF i UPO.
        </p>
    </div>
</div>

<section class="surface form-card mb-4" aria-label="Okres">
    <div class="row g-3 align-items-end">
        <div class="col-sm-4 col-lg-3">
            <label class="form-label" for="month">Miesiąc</label>
            <input id="month" type="month" class="form-control" value="@month" @onchange="OnMonthChanged" />
        </div>
        <div class="col-sm-4 col-lg-3">
            <label class="form-label" for="from">Od</label>
            <input id="from" type="date" class="form-control" value="@Iso(from)" @onchange="e => SetRange(Parse(e.Value), to)" />
        </div>
        <div class="col-sm-4 col-lg-3">
            <label class="form-label" for="to">Do</label>
            <input id="to" type="date" class="form-control" value="@Iso(to)" @onchange="e => SetRange(from, Parse(e.Value))" />
        </div>
    </div>
</section>

<ProblemAlert Problem="problem" />

@if (summary is { } s)
{
    <div class="kpi-grid" data-testid="export-summary">
        <section class="surface kpi">
            <span class="kpi-head"><span><Icon Name="upload" Size="16" /> Sprzedaż</span><span class="pill">wg daty wystawienia</span></span>
            <span class="kpi-value" data-testid="sales-count">@s.SalesCount @Faktur(s.SalesCount)</span>
            <span class="small">netto @Format.Money(s.SalesNet) · VAT @Format.Money(s.SalesVat) · brutto <strong>@Format.Money(s.SalesGross)</strong></span>
            @if (s.SalesForeignCurrency > 0)
            {
                <span class="kpi-note">Kwoty bez @s.SalesForeignCurrency @Faktur(s.SalesForeignCurrency) w walutach obcych (są w zestawieniu z kursem i VAT w PLN).</span>
            }
            <span class="kpi-note">Faktury przyjęte w KSeF.</span>
            <a class="btn btn-sm btn-outline-secondary align-self-start mt-1" href="@Url("sales.csv")" download><Icon Name="download" Size="15" /> Zestawienie sprzedaży (CSV)</a>
        </section>
        <section class="surface kpi">
            <span class="kpi-head"><span><Icon Name="inbox" Size="16" /> Zakupy</span><span class="pill">wg daty otrzymania</span></span>
            <span class="kpi-value" data-testid="purchases-count">@s.PurchasesCount @Faktur(s.PurchasesCount)</span>
            <span class="small">netto @Format.Money(s.PurchasesNet) · VAT @Format.Money(s.PurchasesVat) · brutto <strong>@Format.Money(s.PurchasesGross)</strong></span>
            @if (s.PurchasesForeignCurrency > 0)
            {
                <span class="kpi-note">Kwoty bez @s.PurchasesForeignCurrency @Faktur(s.PurchasesForeignCurrency) w walutach obcych (są w zestawieniu).</span>
            }
            <span class="kpi-note">Faktury otrzymane z KSeF.</span>
            <a class="btn btn-sm btn-outline-secondary align-self-start mt-1" href="@Url("purchases.csv")" download><Icon Name="download" Size="15" /> Zestawienie zakupów (CSV)</a>
        </section>
    </div>

    <section class="todo d-flex flex-wrap align-items-center gap-3">
        <span class="todo-icon icon-primary"><Icon Name="download" Size="20" /></span>
        <div class="flex-grow-1">
            <strong class="d-block">Wszystko w jednym pliku</strong>
            <span class="small muted">Faktury otrzymane pochodzą z ostatniej synchronizacji z KSeF. Faktury w trakcie wysyłki pojawią się
                w zestawieniu po nadaniu numeru KSeF.</span>
        </div>
        <a class="btn btn-primary" href="@Url("package.zip")" download data-testid="download-package"><Icon Name="download" Size="17" /> Pobierz paczkę ZIP (CSV + XML + UPO)</a>
    </section>
}

@code {
    private DateOnly from;
    private DateOnly to;
    private string month = "";
    private ExportSummaryDto? summary;
    private ApiProblem? problem;

    protected override async Task OnInitializedAsync()
    {
        // Domyślnie poprzedni miesiąc - typowy okres rozliczenia z księgową
        var first = new DateOnly(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(-1);
        await SetRange(first, first.AddMonths(1).AddDays(-1));
    }

    private async Task OnMonthChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParseExact($"{e.Value}-01", "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var first))
            await SetRange(first, first.AddMonths(1).AddDays(-1));
    }

    private async Task SetRange(DateOnly? newFrom, DateOnly? newTo)
    {
        if (newFrom is null || newTo is null) return;
        from = newFrom.Value;
        to = newTo.Value;
        month = from.Day == 1 && to == from.AddMonths(1).AddDays(-1) ? from.ToString("yyyy-MM", CultureInfo.InvariantCulture) : "";

        var result = await Api.GetAsync<ExportSummaryDto>(Url("summary"));
        summary = result.Value;
        problem = result.Problem;
    }

    private string Url(string what) => $"api/exports/{what}?from={Iso(from)}&to={Iso(to)}";

    private static string Iso(DateOnly d) => d.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private static DateOnly? Parse(object? value) =>
        DateOnly.TryParseExact(value?.ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var d) ? d : null;

    private static string Faktur(int n) => n == 1 ? "faktura" : n % 10 is >= 2 and <= 4 && n % 100 is < 12 or > 14 ? "faktury" : "faktur";
}
