@page "/kontrahenci"
@inject ApiClient Api

<PageTitle>Kontrahenci - Fakturowanie KSeF</PageTitle>

<div class="page-header">
    <div>
        <h1>Kontrahenci</h1>
        <p class="page-subtitle">Książka adresowa nabywców - dane trafiają na faktury jednym kliknięciem</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" href="kontrahenci/nowy"><Icon Name="plus" Size="17" Stroke="2.2" /> Dodaj kontrahenta</a>
    </div>
</div>

<ProblemAlert Problem="problem" />

<section class="table-card" aria-label="Lista kontrahentów">
    <div class="table-card-toolbar">
        <div class="filters">
            <div class="filter-search">
                <Icon Name="search" Size="16" Stroke="2" />
                <input type="search" class="form-control" placeholder="Szukaj po nazwie lub NIP…" aria-label="Szukaj kontrahenta"
                       @bind="query" @bind:event="oninput" @bind:after="SearchAsync" />
            </div>
        </div>
        @if (customers is { Count: > 0 })
        {
            <span class="muted small">Liczba kontrahentów: @customers.Count</span>
        }
    </div>

    @if (customers is null)
    {
        <p class="muted p-4 mb-0">Wczytywanie…</p>
    }
    else if (customers.Count == 0)
    {
        <div class="empty-state">
            <span class="empty-icon"><Icon Name="users" Size="24" /></span>
            <h2>@(string.IsNullOrWhiteSpace(query) ? "Nie masz jeszcze kontrahentów" : "Brak wyników")</h2>
            <p>@(string.IsNullOrWhiteSpace(query) ? "Nie masz jeszcze żadnych kontrahentów." : "Brak wyników.")</p>
            @if (string.IsNullOrWhiteSpace(query))
            {
                <a class="btn btn-primary" href="kontrahenci/nowy"><Icon Name="plus" Size="17" Stroke="2.2" /> Dodaj pierwszego kontrahenta</a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr><th>Nazwa</th><th>NIP</th><th>Adres</th><th class="d-none d-lg-table-cell">E-mail</th></tr>
                </thead>
                <tbody>
                    @foreach (var c in customers)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="app-avatar">@Initials(c.Name)</span>
                                    <span>
                                        <a class="row-link" href="kontrahenci/@c.Id">@c.Name</a>
                                        @if (!c.IsCompany)
                                        {
                                            <span class="pill ms-1">osoba prywatna</span>
                                        }
                                    </span>
                                </div>
                            </td>
                            <td class="text-nowrap">@Format.Nip(c.Nip)</td>
                            <td>@c.Address.Street<div class="cell-sub">@c.Address.PostalCode @c.Address.City</div></td>
                            <td class="d-none d-lg-table-cell">@c.Email</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private List<CustomerDto>? customers;
    private ApiProblem? problem;
    private string query = string.Empty;
    private CancellationTokenSource? debounce;

    protected override Task OnInitializedAsync() => LoadAsync();

    private static string Initials(string name)
    {
        var letters = name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Where(w => char.IsLetter(w[0])).Take(2).Select(w => char.ToUpperInvariant(w[0]));
        var s = string.Concat(letters);
        return s.Length > 0 ? s : "?";
    }

    private async Task SearchAsync()
    {
        // Krótkie opóźnienie, żeby nie wysyłać zapytania po każdym naciśnięciu klawisza
        debounce?.Cancel();
        debounce = new CancellationTokenSource();
        try { await Task.Delay(300, debounce.Token); } catch (TaskCanceledException) { return; }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<List<CustomerDto>>($"api/customers?q={Uri.EscapeDataString(query)}");
        problem = result.Problem;
        customers = result.Value ?? [];
    }
}
