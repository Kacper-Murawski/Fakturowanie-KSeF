@page "/register"
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>Rejestracja - Fakturowanie KSeF</PageTitle>

<div class="auth-card">
    @if (registeredEmail is not null)
    {
        <h1 class="h3 mb-1">Sprawdź skrzynkę</h1>
        <div data-testid="check-mailbox">
            <p class="muted">
                Wysłaliśmy link potwierdzający na adres <strong class="text-break">@registeredEmail</strong>. Kliknij go, aby aktywować konto -
                link jest ważny 24 godziny. Potem zalogujesz się i uzupełnisz dane firmy.
            </p>
            <p class="small text-muted">Nie widzisz wiadomości? Sprawdź folder ze spamem albo wyślij link ponownie.</p>
            @if (resent)
            {
                <div class="alert alert-success small" role="status">Jeśli konto wymaga potwierdzenia, wysłaliśmy nowy link.</div>
            }
            <button type="button" class="btn btn-outline-secondary w-100" disabled="@busy" @onclick="ResendAsync">Wyślij link ponownie</button>
            <p class="mt-3 mb-0 text-center"><a href="login">Przejdź do logowania</a></p>
        </div>
    }
    else
    {
    <h1 class="h3 mb-1">Załóż konto</h1>
    <p class="muted mb-4">Konto jest bezpłatne. Po rejestracji potwierdzisz adres e-mail, uzupełnisz dane firmy i połączysz ją z testowym KSeF.</p>

    <EditForm Model="model" OnValidSubmit="RegisterAsync" FormName="register">
        <DataAnnotationsValidator />

        @if (errors.Count > 0)
        {
            <div class="alert alert-danger" role="alert">
                <ul class="mb-0">
                    @foreach (var e in errors)
                    {
                        <li>@e</li>
                    }
                </ul>
            </div>
        }

        <div class="mb-3">
            <label class="form-label" for="email">E-mail</label>
            <InputText id="email" type="email" class="form-control" @bind-Value="model.Email" autocomplete="username" />
            <ValidationMessage For="() => model.Email" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="password">Hasło</label>
            <InputText id="password" type="password" class="form-control" @bind-Value="model.Password" autocomplete="new-password" />
            <div class="form-text">Co najmniej 8 znaków, w tym wielka i mała litera, cyfra oraz znak specjalny.</div>
            <ValidationMessage For="() => model.Password" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="password2">Powtórz hasło</label>
            <InputText id="password2" type="password" class="form-control" @bind-Value="model.ConfirmPassword" autocomplete="new-password" />
            <ValidationMessage For="() => model.ConfirmPassword" />
        </div>

        <button type="submit" class="btn btn-primary w-100" disabled="@busy">
            @(busy ? "Zakładanie konta…" : "Zarejestruj się")
        </button>
    </EditForm>

    <p class="mt-3 mb-0 text-center">Masz już konto? <a href="login">Zaloguj się</a></p>
    }
</div>

@code {
    private readonly RegisterModel model = new();
    private List<string> errors = [];
    private bool busy;
    private string? registeredEmail;
    private bool resent;

    private async Task RegisterAsync()
    {
        busy = true;
        errors = (await Auth.RegisterAsync(model.Email, model.Password)).ToList();
        // Logowanie dopiero po potwierdzeniu adresu linkiem z wiadomości (D53)
        if (errors.Count == 0) registeredEmail = model.Email.Trim();
        busy = false;
    }

    private async Task ResendAsync()
    {
        busy = true;
        resent = await Auth.ResendConfirmationAsync(registeredEmail!);
        busy = false;
    }

    private sealed class RegisterModel
    {
        [Required(ErrorMessage = "Podaj adres e-mail.")]
        [EmailAddress(ErrorMessage = "Nieprawidłowy adres e-mail.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Podaj hasło.")]
        [MinLength(8, ErrorMessage = "Hasło musi mieć co najmniej 8 znaków.")]
        public string Password { get; set; } = string.Empty;

        [Compare(nameof(Password), ErrorMessage = "Hasła nie są takie same.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
