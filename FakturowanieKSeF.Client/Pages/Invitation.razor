@page "/zaproszenie"
@inject ApiClient Api
@inject NavigationManager Navigation
@inject CompanyContext Ctx

<PageTitle>Zaproszenie - Fakturowanie KSeF</PageTitle>

<div class="page-header">
    <div>
        <h1>Zaproszenie do firmy</h1>
        <p class="page-subtitle">Po przyjęciu firma pojawi się w przełączniku firm w górnym pasku.</p>
    </div>
</div>

<ProblemAlert Problem="problem" />

@if (preview is { } p)
{
    <div class="surface form-card form-narrow" data-testid="invitation">
        <div>
            <p><strong>@p.CompanyName</strong> (NIP @Format.Nip(p.CompanyNip)) zaprasza Cię z rolą <strong>@CompanyContext.RoleName(p.Role)</strong>.</p>
            <p class="small text-muted">
                @(p.Role == CompanyRole.Accountant
                    ? "Księgowa widzi faktury i dane firmy, pobiera eksporty i rejestruje płatności - nie wystawia faktur."
                    : "Pracownik wystawia i wysyła faktury do KSeF, prowadzi kontrahentów i katalog - nie zmienia ustawień firmy.")
                Zaproszenie dla adresu @p.Email, ważne do @Format.Date(DateOnly.FromDateTime(p.ExpiresAt)).
            </p>
            <button class="btn btn-primary" disabled="@busy" @onclick="AcceptAsync">Przyjmij zaproszenie</button>
        </div>
    </div>
}
else if (problem is null)
{
    <p class="text-muted">Wczytywanie…</p>
}

@code {
    // Token we fragmencie adresu (#token=…) - nie trafia do logów serwera (SEC-9); starsze linki: ?token=…
    private string? Token;

    private InvitationPreviewDto? preview;
    private ApiProblem? problem;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        Token = UrlFragment.Get(Navigation.Uri, "token");
        if (string.IsNullOrWhiteSpace(Token))
        {
            problem = new ApiProblem { Status = 404, Title = "Brak tokenu zaproszenia w adresie." };
            return;
        }
        var result = await Api.PostAsync<InvitationPreviewDto>("api/account/invitations/preview", new AcceptInvitationRequest { Token = Token });
        preview = result.Value;
        problem = result.Problem;
    }

    private async Task AcceptAsync()
    {
        busy = true;
        var result = await Api.PostAsync<AccessibleCompanyDto>("api/account/invitations/accept", new AcceptInvitationRequest { Token = Token! });
        busy = false;
        problem = result.Problem;
        if (result.Value is not null)
        {
            Ctx.Reset();
            Navigation.NavigateTo("", forceLoad: true);
        }
    }
}
