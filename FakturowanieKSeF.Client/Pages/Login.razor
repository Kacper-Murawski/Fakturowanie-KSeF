@page "/login"
@attribute [AllowAnonymous]
@inject AuthService Auth
@inject NavigationManager Navigation
@inject CompanyContext Ctx

<PageTitle>Logowanie - Fakturowanie KSeF</PageTitle>

<div class="auth-card">
    <h1 class="h3 mb-1">Logowanie</h1>
    <p class="muted mb-4">Witaj ponownie! Zaloguj się, aby wystawiać i odbierać faktury w KSeF.</p>

    <EditForm Model="model" OnValidSubmit="LoginAsync" FormName="login">
        <DataAnnotationsValidator />

        @if (error is not null)
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }

        @if (!twoFactor)
        {
        <div class="mb-3">
            <label class="form-label" for="email">E-mail</label>
            <InputText id="email" type="email" class="form-control" @bind-Value="model.Email" autocomplete="username" />
            <ValidationMessage For="() => model.Email" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="password">Hasło</label>
            <InputText id="password" type="password" class="form-control" @bind-Value="model.Password" autocomplete="current-password" />
            <ValidationMessage For="() => model.Password" />
        </div>
        }
        else
        {
            <p class="small">Logowanie dwuskładnikowe jest włączone dla tego konta.</p>
            @if (!useRecovery)
            {
                <div class="mb-3">
                    <label class="form-label" for="two-factor-code">Kod z aplikacji uwierzytelniającej</label>
                    <input id="two-factor-code" class="form-control" inputmode="numeric" autocomplete="one-time-code" maxlength="7"
                           @bind="code" @bind:event="oninput" />
                </div>
                <button type="button" class="btn btn-link btn-sm p-0 mb-3" @onclick="() => { useRecovery = true; code = null; }">
                    Nie mam dostępu do telefonu - użyj kodu odzyskiwania
                </button>
            }
            else
            {
                <div class="mb-3">
                    <label class="form-label" for="recovery-code">Kod odzyskiwania</label>
                    <input id="recovery-code" class="form-control" autocomplete="off" maxlength="20" @bind="code" @bind:event="oninput" />
                    <div class="form-text">Każdy kod odzyskiwania działa tylko raz.</div>
                </div>
            }
        }

        <button type="submit" class="btn btn-primary w-100" disabled="@busy">
            @(busy ? "Logowanie…" : "Zaloguj się")
        </button>
    </EditForm>

    <p class="mt-4 mb-0 text-center">Nie masz konta? <a class="fw-semibold" href="register">Zarejestruj się</a></p>
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private readonly LoginModel model = new();
    private string? error;
    private bool busy;
    private bool twoFactor;
    private bool useRecovery;
    private string? code;

    private async Task LoginAsync()
    {
        if (twoFactor && string.IsNullOrWhiteSpace(code))
        {
            error = "Podaj kod.";
            return;
        }

        busy = true;
        var result = await Auth.LoginAsync(model.Email, model.Password,
            twoFactor && !useRecovery ? code : null, twoFactor && useRecovery ? code : null);
        busy = false;
        error = result.Error;
        twoFactor = result.RequiresTwoFactor;

        if (result.Succeeded)
        {
            Ctx.Reset();
            // Tylko adresy względne - ochrona przed przekierowaniem na obcą stronę (open redirect)
            var target = string.IsNullOrEmpty(ReturnUrl) || ReturnUrl.Contains("://") || ReturnUrl.StartsWith("//") ? "" : ReturnUrl;
            Navigation.NavigateTo(target);
        }
    }

    private sealed class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Podaj adres e-mail.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Nieprawidłowy adres e-mail.")]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Podaj hasło.")]
        public string Password { get; set; } = string.Empty;
    }
}
