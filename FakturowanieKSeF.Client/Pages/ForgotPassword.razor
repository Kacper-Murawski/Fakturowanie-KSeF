@page "/nie-pamietam-hasla"
@attribute [AllowAnonymous]
@inject AuthService Auth

<PageTitle>Nie pamiętam hasła - Fakturowanie KSeF</PageTitle>

<div class="auth-card">
    <h1 class="h3 mb-1">Nie pamiętasz hasła?</h1>

    @if (sent)
    {
        <div class="alert alert-success" role="status" data-testid="reset-sent">
            Jeśli konto z adresem <strong class="text-break">@email</strong> istnieje i ma potwierdzony adres, wysłaliśmy na nie link do ustawienia
            nowego hasła. Link jest ważny 1 godzinę.
        </div>
        <p class="mb-0 text-center"><a href="login">Wróć do logowania</a></p>
    }
    else
    {
        <p class="muted mb-4">Podaj adres e-mail konta - wyślemy link do ustawienia nowego hasła.</p>
        @if (error is not null)
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }
        <form @onsubmit="SendAsync" @onsubmit:preventDefault>
            <div class="mb-3">
                <label class="form-label" for="email">E-mail</label>
                <input id="email" type="email" class="form-control" autocomplete="username" maxlength="254"
                       @bind="email" @bind:event="oninput" />
            </div>
            <button type="submit" class="btn btn-primary w-100" disabled="@busy">@(busy ? "Wysyłanie…" : "Wyślij link")</button>
        </form>
        <p class="mt-3 mb-0 text-center"><a href="login">Wróć do logowania</a></p>
    }
</div>

@code {
    private string? email;
    private string? error;
    private bool sent;
    private bool busy;

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(email) || !email.Contains('@'))
        {
            error = "Podaj adres e-mail.";
            return;
        }
        busy = true;
        error = null;
        // Odpowiedź zawsze ta sama - aplikacja nie zdradza, czy konto z tym adresem istnieje (D53)
        sent = await Auth.ForgotPasswordAsync(email.Trim());
        if (!sent) error = "Nie udało się wysłać prośby. Spróbuj ponownie za chwilę.";
        busy = false;
    }
}
