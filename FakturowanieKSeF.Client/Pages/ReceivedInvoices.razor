@page "/faktury-otrzymane"
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>Faktury otrzymane - Fakturowanie KSeF</PageTitle>

<div class="page-header">
    <div>
        <h1>Faktury otrzymane</h1>
        <p class="page-subtitle">Faktury kosztowe wystawione na NIP Twojej firmy, pobrane z KSeF (środowisko testowe)</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-primary" @onclick="SyncAsync" disabled="@(syncing || status is { HasToken: false })">
            @if (syncing)
            {
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            }
            else
            {
                <Icon Name="refresh" Size="17" />
            }
            Pobierz z KSeF
        </button>
    </div>
</div>

@if (status is { HasToken: false })
{
    <div class="alert alert-info d-flex gap-2 align-items-start">
        <Icon Name="info" Size="20" />
        <span>Aby pobierać faktury z KSeF, <a href="firma">skonfiguruj token KSeF</a> w ustawieniach firmy.</span>
    </div>
}
else if (status is not null)
{
    <div class="surface d-flex flex-wrap align-items-center gap-3 px-3 py-2 mb-3 small">
        <span class="pill pill-success pill-dot">Pobieranie automatyczne co 15 min</span>
        <span>Ostatnia synchronizacja: <strong>@Format.DateTime(status.LastSyncAt)</strong></span>
        @if (status.SyncedUntil is not null)
        {
            <span class="muted">kompletne dane do @Format.DateTime(status.SyncedUntil)</span>
        }
        @if (status.LastError is not null)
        {
            <span class="text-danger w-100">Błąd ostatniej synchronizacji: @status.LastError</span>
        }
        <span class="muted w-100">Nowa faktura jest dostępna w KSeF po jej trwałym zapisaniu - zwykle kilka minut po wystawieniu.</span>
    </div>
}

@if (syncMessage is not null)
{
    <div class="alert alert-success" role="status">@syncMessage</div>
}
<ProblemAlert Problem="problem" />

<section class="table-card" aria-label="Lista faktur otrzymanych">
    <div class="table-card-toolbar">
        <div class="filters">
            <div class="filter-search">
                <label class="visually-hidden" for="q">Szukaj</label>
                <Icon Name="search" Size="16" Stroke="2" />
                <input id="q" type="search" class="form-control" placeholder="Numer faktury, sprzedawca, NIP, numer KSeF…" @bind="Q" @bind:event="oninput" @bind:after="SearchAsync" />
            </div>
            <label class="visually-hidden" for="payment">Płatność</label>
            <select id="payment" class="form-select" @bind="Payment" @bind:after="ApplyFilters">
                <option value="">Płatność: wszystkie</option>
                <option value="@PaymentFilter.Unpaid">Do zapłaty</option>
                <option value="@PaymentFilter.Overdue">Po terminie</option>
                <option value="@PaymentFilter.Paid">Zapłacone</option>
            </select>
            <span class="filter-dates">
                <label class="visually-hidden" for="from">Wystawione od</label>
                <input id="from" type="date" class="form-control" title="Wystawione od" @bind="From" @bind:after="ApplyFilters" />
                <span class="muted" aria-hidden="true">–</span>
                <label class="visually-hidden" for="to">Wystawione do</label>
                <input id="to" type="date" class="form-control" title="Wystawione do" @bind="To" @bind:after="ApplyFilters" />
            </span>
        </div>
    </div>

    @if (data is null)
    {
        <p class="muted p-4 mb-0">Wczytywanie…</p>
    }
    else if (data.TotalCount == 0)
    {
        <div class="empty-state">
            <span class="empty-icon"><Icon Name="inbox" Size="24" /></span>
            <h2>Brak faktur</h2>
            <p class="mb-0">Brak faktur otrzymanych@(string.IsNullOrWhiteSpace(Q) && string.IsNullOrEmpty(Payment) && From is null && To is null ? "" : " spełniających kryteria").</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle table-stack">
                <thead>
                    <tr>
                        <th>Numer faktury</th><th>Sprzedawca</th><th>Wystawiona</th><th class="d-none d-xl-table-cell">Otrzymana (KSeF)</th>
                        <th class="text-end">Brutto</th><th>Płatność</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in data.Items)
                    {
                        <tr role="button" @onclick="() => Open(r.Id)">
                            <td data-col="main">
                                <a class="row-link" href="faktury-otrzymane/@r.Id">@r.InvoiceNumber</a>
                                @if (r.BankAccountOnWhiteList == false)
                                {
                                    <div class="mt-1"><span class="pill pill-danger" title="Rachunku z faktury nie ma w wykazie podatników VAT dla tego sprzedawcy">rachunek spoza białej listy</span></div>
                                }
                            </td>
                            <td data-col="party">@r.SellerName<div class="cell-sub text-nowrap">NIP @Format.Nip(r.SellerNip)</div></td>
                            <td data-col="date" data-label="Wystawiona" class="text-nowrap">@Format.Date(r.IssueDate)</td>
                            <td data-col="extra" class="d-none d-xl-table-cell text-nowrap">@Format.DateTime(r.KsefAcceptedAt)</td>
                            <td data-col="amount" class="text-end text-nowrap">
                                <span class="cell-main">@Format.Money(r.TotalGross, r.Currency)</span>
                                <div class="cell-sub">netto @Format.Money(r.TotalNet, r.Currency)</div>
                            </td>
                            <td data-col="status">
                                <PaymentBadge Status="r.PaymentStatus" IsOverdue="r.IsOverdue" />
                                @if (r.DueDate is not null && r.PaymentStatus != PaymentStatus.Paid)
                                {
                                    <div class="cell-sub mt-1">termin @Format.Date(r.DueDate)</div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <nav class="table-card-footer" aria-label="Stronicowanie">
            <span class="muted">Faktury @((data.Page - 1) * data.PageSize + 1)–@Math.Min(data.Page * data.PageSize, data.TotalCount) z @data.TotalCount</span>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary btn-sm" disabled="@(data.Page <= 1)" @onclick="() => GoTo(data.Page - 1)"><Icon Name="chevron-left" Size="16" /> Poprzednia</button>
                <button class="btn btn-outline-secondary btn-sm" disabled="@(data.Page * data.PageSize >= data.TotalCount)" @onclick="() => GoTo(data.Page + 1)">Następna <Icon Name="chevron-right" Size="16" /></button>
            </div>
        </nav>
    }
</section>

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "payment")] public string? Payment { get; set; }
    [SupplyParameterFromQuery(Name = "from")] public DateOnly? From { get; set; }
    [SupplyParameterFromQuery(Name = "to")] public DateOnly? To { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? PageNumber { get; set; }

    private PagedResult<ReceivedInvoiceListItemDto>? data;
    private ReceivedSyncStatusDto? status;
    private ApiProblem? problem;
    private string? syncMessage;
    private bool syncing;
    private CancellationTokenSource? debounce;

    protected override async Task OnParametersSetAsync()
    {
        status = (await Api.GetAsync<ReceivedSyncStatusDto>("api/received-invoices/sync-status")).Value;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var query = new List<string> { $"page={PageNumber ?? 1}", "pageSize=20" };
        if (!string.IsNullOrWhiteSpace(Q)) query.Add($"q={Uri.EscapeDataString(Q)}");
        if (!string.IsNullOrEmpty(Payment)) query.Add($"payment={Payment}");
        if (From is not null) query.Add($"from={From:yyyy-MM-dd}");
        if (To is not null) query.Add($"to={To:yyyy-MM-dd}");

        var result = await Api.GetAsync<PagedResult<ReceivedInvoiceListItemDto>>($"api/received-invoices?{string.Join('&', query)}");
        problem = result.Problem;
        data = result.Value ?? new PagedResult<ReceivedInvoiceListItemDto>([], 0, 1, 20);
    }

    private async Task SyncAsync()
    {
        syncing = true;
        syncMessage = null;
        var result = await Api.PostAsync<SyncResultDto>("api/received-invoices/sync", new { });
        syncing = false;

        problem = result.Problem;
        if (result.Value is { } r)
            syncMessage = r.Downloaded == 0
                ? "Brak nowych faktur w KSeF."
                : $"Pobrano nowe faktury: {r.Downloaded}." + (r.Complete ? "" : " Pozostałe zostaną pobrane w kolejnym przebiegu (limity KSeF).");

        status = (await Api.GetAsync<ReceivedSyncStatusDto>("api/received-invoices/sync-status")).Value;
        await LoadAsync();
    }

    private async Task SearchAsync()
    {
        debounce?.Cancel();
        debounce = new CancellationTokenSource();
        try { await Task.Delay(300, debounce.Token); } catch (TaskCanceledException) { return; }
        ApplyFilters();
    }

    private void ApplyFilters() { PageNumber = 1; UpdateUrl(); }

    private void GoTo(int page) { PageNumber = page; UpdateUrl(); }

    private void Open(int id) => Navigation.NavigateTo($"faktury-otrzymane/{id}");

    private void UpdateUrl() => Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
    {
        ["q"] = string.IsNullOrWhiteSpace(Q) ? null : Q,
        ["payment"] = string.IsNullOrEmpty(Payment) ? null : Payment,
        ["from"] = From?.ToString("yyyy-MM-dd"),
        ["to"] = To?.ToString("yyyy-MM-dd"),
        ["page"] = PageNumber is > 1 ? PageNumber : null
    }));
}
