@page "/reset-hasla"
@attribute [AllowAnonymous]
@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>Nowe hasło - Fakturowanie KSeF</PageTitle>

<div class="auth-card">
    <h1 class="h3 mb-1">Ustaw nowe hasło</h1>

    @if (done)
    {
        <div class="alert alert-success" role="status" data-testid="password-changed">
            Hasło zostało zmienione. Wszystkie wcześniejsze sesje zostały wylogowane.
            Jeśli masz włączone logowanie dwuskładnikowe, nadal będzie potrzebny kod z aplikacji.
        </div>
        <a class="btn btn-primary w-100" href="login">Zaloguj się</a>
    }
    else if (email is null || code is null)
    {
        <div class="alert alert-danger" role="alert">Link jest niepełny. Otwórz go ponownie z wiadomości albo poproś o nowy.</div>
        <p class="mb-0 text-center"><a href="nie-pamietam-hasla">Wyślij nowy link</a></p>
    }
    else
    {
        <p class="muted mb-4">Konto: <strong class="text-break">@email</strong></p>
        @if (errors.Count > 0)
        {
            <div class="alert alert-danger" role="alert">
                <ul class="mb-0">
                    @foreach (var e in errors)
                    {
                        <li>@e</li>
                    }
                </ul>
            </div>
        }
        <form @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <div class="mb-3">
                <label class="form-label" for="password">Nowe hasło</label>
                <input id="password" type="password" class="form-control" autocomplete="new-password" maxlength="200"
                       @bind="password" @bind:event="oninput" />
                <div class="form-text">Co najmniej 8 znaków, w tym wielka i mała litera, cyfra oraz znak specjalny.</div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="password2">Powtórz hasło</label>
                <input id="password2" type="password" class="form-control" autocomplete="new-password" maxlength="200"
                       @bind="password2" @bind:event="oninput" />
            </div>
            <button type="submit" class="btn btn-primary w-100" disabled="@busy">@(busy ? "Zapisywanie…" : "Ustaw hasło")</button>
        </form>
        <p class="mt-3 mb-0 text-center"><a href="nie-pamietam-hasla">Wyślij nowy link</a></p>
    }
</div>

@code {
    private string? email;
    private string? code;
    private string? password;
    private string? password2;
    private List<string> errors = [];
    private bool busy;
    private bool done;

    protected override void OnInitialized()
    {
        // Kod we fragmencie adresu (#…) - nie trafia do logów serwera
        email = UrlFragment.Get(Navigation.Uri, "email");
        code = UrlFragment.Get(Navigation.Uri, "code");
    }

    private async Task SaveAsync()
    {
        errors = [];
        if (string.IsNullOrEmpty(password) || password.Length < 8) errors.Add("Hasło musi mieć co najmniej 8 znaków.");
        else if (password != password2) errors.Add("Hasła nie są takie same.");
        if (errors.Count > 0) return;

        busy = true;
        errors = (await Auth.ResetPasswordAsync(email!, code!, password!)).ToList();
        done = errors.Count == 0;
        busy = false;
    }
}
