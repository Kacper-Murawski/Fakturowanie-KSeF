@page "/faktury-otrzymane/{Id:int}"
@inject ApiClient Api

<PageTitle>Faktura otrzymana - Fakturowanie KSeF</PageTitle>

<ProblemAlert Problem="problem" />

@if (invoice is null)
{
    @if (problem is null)
    {
        <p class="text-muted">Wczytywanie…</p>
    }
}
else
{
    var doc = invoice.Document;
    <div class="page-header">
        <div>
            <a class="small fw-semibold d-inline-flex align-items-center gap-1 mb-1" href="faktury-otrzymane"><Icon Name="chevron-left" Size="15" /> Faktury otrzymane</a>
            <h1 class="mb-2">Faktura @(doc?.InvoiceType ?? "VAT") @doc?.InvoiceNumber</h1>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="pill pill-info">Otrzymana z KSeF</span>
                @if (invoice.Payment is { } pay)
                {
                    <PaymentBadge Status="pay.Status" IsOverdue="pay.IsOverdue" />
                }
                <span class="small muted">Numer KSeF: <strong class="text-body">@invoice.KsefNumber</strong> · otrzymana @Format.DateTime(invoice.KsefAcceptedAt)</span>
            </div>
        </div>
        <div class="page-actions">
            <a class="btn btn-outline-secondary" href="api/received-invoices/@invoice.Id/pdf" download><Icon Name="printer" Size="16" /> Pobierz PDF</a>
            <a class="btn btn-outline-secondary" href="api/received-invoices/@invoice.Id/xml" download><Icon Name="file" Size="16" /> Pobierz XML</a>
        </div>
    </div>

    @if (invoice.DocumentError is not null)
    {
        <div class="alert alert-warning">@invoice.DocumentError Pełna treść faktury jest dostępna w pliku XML.</div>
    }

    <div class="form-layout">
    <div class="form-main">
    @if (doc is not null)
    {
        <div class="invoice-sheet surface">
            <div class="sheet-body">
                @if (doc.IsCorrection)
                {
                    <div class="alert alert-secondary small" data-testid="received-correction">
                        @foreach (var k in doc.CorrectedInvoices ?? [])
                        {
                            <div>Korekta faktury <strong>@k.Number</strong>@(k.IssueDate is { } d ? $" z dnia {Format.Date(d)}" : "")@(k.KsefNumber is null ? "" : $", numer KSeF {k.KsefNumber}")</div>
                        }
                        @if (doc.CorrectionReason is not null)
                        {
                            <div>Przyczyna: <strong>@doc.CorrectionReason</strong></div>
                        }
                        <div>Wiersze oznaczone „przed” to stan przed korektą; kwoty podsumowania to różnica.</div>
                    </div>
                }
                <div class="sheet-head">
                    <div>
                        <div class="sheet-kind">Faktura @(doc.InvoiceType ?? "VAT") · otrzymana</div>
                        <div class="sheet-number">@doc.InvoiceNumber</div>
                    </div>
                    <dl class="sheet-dates">
                        <dt>Data wystawienia</dt><dd>@Format.Date(doc.IssueDate)</dd>
                        <dt>Data sprzedaży</dt><dd>@Format.Date(doc.SaleDate ?? doc.IssueDate)</dd>
                        @if (doc.DueDate is not null)
                        {
                            <dt>Termin płatności</dt><dd>@Format.Date(doc.DueDate)</dd>
                        }
                    </dl>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-sm-6">
                        <div class="sheet-party">
                            <h2 class="sheet-label">Sprzedawca</h2>
                            <DocumentParty Data="doc.Seller" />
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="sheet-party">
                            <h2 class="sheet-label">Nabywca</h2>
                            <DocumentParty Data="doc.Buyer" />
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr><th>Lp.</th><th>Nazwa</th><th>J.m.</th><th class="text-end">Ilość</th><th class="text-end">Cena netto</th><th class="text-end">Wartość netto</th><th>VAT</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var l in doc.Lines)
                            {
                                <tr>
                                    <td>@l.Number</td>
                                    <td>
                                        @l.Name
                                        @if (l.BeforeCorrection)
                                        {
                                            <span class="pill ms-1">przed</span>
                                        }
                                    </td>
                                    <td>@l.Unit</td>
                                    <td class="text-end">@(l.Quantity is { } q ? Format.Quantity(q) : "")</td>
                                    <td class="text-end">@(l.UnitNetPrice is { } p ? Format.Amount(p) : "")</td>
                                    <td class="text-end">@(l.NetAmount is { } n ? Format.Amount(n) : "")</td>
                                    <td>@VatLabel(l.VatRate)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="row justify-content-end mt-3">
                    <div class="col-md-7 col-xl-6">
                        <table class="table table-sm summary-table">
                            <thead><tr><th>Stawka</th><th class="text-end">Netto</th><th class="text-end">VAT</th></tr></thead>
                            <tbody>
                                @foreach (var s in doc.VatSummary)
                                {
                                    <tr><td>@s.Label</td><td class="text-end">@Format.Amount(s.Net)</td><td class="text-end">@(s.Vat is { } v ? Format.Amount(v) : "—")</td></tr>
                                }
                            </tbody>
                        </table>
                        <p class="fs-5 text-end sheet-total">Do zapłaty: <strong>@Format.Money(doc.TotalGross, doc.Currency)</strong></p>
                    </div>
                </div>

                <div class="small sheet-payment">
                    @if (doc.PaymentMethod is not null)
                    {
                        <span>Forma płatności: <strong>@doc.PaymentMethod</strong></span>
                    }
                    @if (doc.DueDate is not null)
                    {
                        <span>, termin: <strong>@Format.Date(doc.DueDate)</strong></span>
                    }
                    @if (doc.PaidOn is not null)
                    {
                        <span>, <strong class="text-success">sprzedawca oznaczył fakturę jako zapłaconą @Format.Date(doc.PaidOn)</strong></span>
                    }
                    @if (doc.BankAccount is not null)
                    {
                        <br /><span>Rachunek: <strong>@Format.BankAccount(doc.BankAccount)</strong></span>
                    }
                </div>

                @if (doc.BankAccount is not null)
                {
                    <div class="mt-3" data-testid="bank-check">
                        @if (invoice.BankAccountCheck is { } check)
                        {
                            <div class="alert @(check.OnWhiteList ? "alert-success" : "alert-danger") mb-2" role="status">
                                @if (check.OnWhiteList)
                                {
                                    <strong>Rachunek jest na białej liście</strong>
                                    <span>- przypisany do sprzedawcy w wykazie podatników VAT.</span>
                                }
                                else
                                {
                                    <strong>Rachunku nie ma na białej liście dla tego sprzedawcy.</strong>
                                    <span>Przed zapłatą wyjaśnij to ze sprzedawcą - zapłata powyżej 15 000 zł na rachunek spoza wykazu
                                        pozbawia prawa do zaliczenia wydatku do kosztów i grozi solidarną odpowiedzialnością za VAT.</span>
                                }
                                <div class="small mt-1">
                                    Stan na @Format.Date(check.CheckedOn)@(check.RequestId is null ? "" : $", identyfikator zapytania MF: {check.RequestId}").
                                </div>
                            </div>
                        }
                        else if (doc.Currency == "PLN" && doc.TotalGross > BankAccountCheckDto.ThresholdGross)
                        {
                            <div class="alert alert-info mb-2">
                                Kwota przekracza 15 000 zł - przed przelewem sprawdź, czy rachunek jest na białej liście.
                            </div>
                        }
                        <button type="button" class="btn btn-sm btn-outline-primary" disabled="@checking" @onclick="CheckBankAccountAsync">
                            @(checking ? "Sprawdzanie…" : invoice.BankAccountCheck is null ? "Sprawdź rachunek na białej liście" : "Sprawdź ponownie (stan na dziś)")
                        </button>
                        <ProblemAlert Problem="checkProblem" />
                    </div>
                }
            </div>
        </div>
    }
    </div>
    <aside class="form-aside">
    @if (invoice.Payment is { } payment)
    {
        <PaymentPanel InvoiceUrl="@($"api/received-invoices/{invoice.Id}")" Info="payment" Received="true"
                      TotalGross="doc?.TotalGross ?? payment.PaidAmount + payment.Remaining" Currency="@(doc?.Currency ?? "PLN")"
                      DueDate="doc?.DueDate" InfoChanged="info => invoice = invoice with { Payment = info }" />
    }

    </aside>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private ReceivedInvoiceDto? invoice;
    private ApiProblem? problem, checkProblem;
    private bool checking;

    protected override async Task OnParametersSetAsync()
    {
        var result = await Api.GetAsync<ReceivedInvoiceDto>($"api/received-invoices/{Id}");
        invoice = result.Value;
        problem = result.Problem;
    }

    private async Task CheckBankAccountAsync()
    {
        checking = true;
        var result = await Api.PostAsync<BankAccountCheckDto>($"api/received-invoices/{Id}/bank-account-check", new { });
        checking = false;
        checkProblem = result.Problem;
        if (result.Value is { } check) invoice = invoice! with { BankAccountCheck = check };
    }

    private static string VatLabel(string? code) => code switch
    {
        null => "",
        "zw" or "oo" or "np I" or "np II" => code,
        _ when code.StartsWith("0 ") => "0% " + code[2..],
        _ => code + "%"
    };
}
