@inherits LayoutComponentBase
@inject AuthService Auth
@inject NavigationManager Navigation

<div class="page">
    <AuthorizeView>
        <Authorized>
            <div class="sidebar">
                <NavMenu />
            </div>
        </Authorized>
    </AuthorizeView>

    <main>
        <AuthorizeView>
            <Authorized>
                <div class="top-row px-4 justify-content-end gap-3">
                    <a class="text-muted small text-decoration-none" href="konto" title="Bezpieczeństwo konta">@context.User.Identity?.Name</a>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="LogoutAsync">Wyloguj</button>
                </div>
            </Authorized>
        </AuthorizeView>

        <article class="content px-4 py-3">
            <div class="alert alert-warning py-1 px-2 small mb-3" role="note">
                Wersja testowa: faktury są wysyłane wyłącznie do <strong>testowego</strong> środowiska KSeF i nie mają mocy prawnej.
            </div>
            @Body
        </article>
    </main>
</div>

@code {
    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Navigation.NavigateTo("login");
    }
}
