@inherits LayoutComponentBase
@inject AuthService Auth
@inject NavigationManager Navigation
@inject CompanyContext Ctx

<AuthorizeView>
    <Authorized>
        <a class="skip-link" href="#content">Przejdź do treści</a>
        <div class="app-shell">
            <NavMenu Open="menuOpen" OnNavigate="CloseMenu" />
            <div class="app-backdrop @(menuOpen ? "open" : null)" @onclick="CloseMenu"></div>

            <div class="app-main">
                <header class="app-topbar top-row">
                    <button type="button" class="navbar-toggler app-icon-btn" aria-label="Menu" aria-expanded="@(menuOpen ? "true" : "false")"
                            @onclick="ToggleMenu">
                        <Icon Name="menu" Size="20" />
                    </button>

                    <form class="app-search" role="search" @onsubmit="SearchAsync" @onsubmit:preventDefault>
                        <label for="global-search" class="visually-hidden">Szukaj faktur</label>
                        <span class="app-search-icon"><Icon Name="search" Size="17" Stroke="2" /></span>
                        <input id="global-search" type="search" class="form-control" placeholder="Szukaj faktur: numer, nabywca, NIP…"
                               autocomplete="off" @bind="search" />
                    </form>

                    <div class="app-topbar-actions">
                        <CompanySwitcher />
                        <span class="pill pill-warning pill-dot d-none d-md-inline-flex" title="Faktury są wysyłane wyłącznie do testowego środowiska KSeF i nie mają mocy prawnej.">
                            KSeF testowy
                        </span>
                        <ThemeToggle />
                        <a class="app-user" href="konto" title="Konto i bezpieczeństwo">
                            <span class="app-avatar app-avatar-solid">@Initials(context.User.Identity?.Name)</span>
                            <span class="app-user-name" data-testid="user-email">@context.User.Identity?.Name</span>
                        </a>
                        <button type="button" class="btn btn-outline-secondary" @onclick="LogoutAsync" title="Wyloguj" aria-label="Wyloguj">
                            <Icon Name="logout" Size="17" /><span class="d-none d-lg-inline">Wyloguj</span>
                        </button>
                    </div>
                </header>

                <main class="app-content" id="content">
                    <p class="visually-hidden" role="note">
                        Wersja testowa: faktury są wysyłane wyłącznie do testowego środowiska KSeF i nie mają mocy prawnej.
                    </p>
                    @Body
                </main>
            </div>
        </div>

        @* Telefon: dolny pasek z najczęstszymi miejscami i dużym przyciskiem nowej faktury (D50) *@
        <nav class="app-bottom-nav" aria-label="Nawigacja dolna">
            <NavLink href="" Match="NavLinkMatch.All"><Icon Name="home" Size="22" /><span>Pulpit</span></NavLink>
            <NavLink href="faktury" Match="NavLinkMatch.All"><Icon Name="file" Size="22" /><span>Faktury</span></NavLink>
            @if (Ctx.CanIssue)
            {
                <NavLink class="app-bottom-cta" href="faktury/nowa" Match="NavLinkMatch.All" aria-label="Wystaw fakturę"><Icon Name="plus" Size="24" Stroke="2.4" /></NavLink>
            }
            <NavLink href="faktury-otrzymane"><Icon Name="inbox" Size="22" /><span>Otrzymane</span></NavLink>
            <button type="button" @onclick="ToggleMenu" aria-expanded="@(menuOpen ? "true" : "false")"><Icon Name="menu" Size="22" /><span>Więcej</span></button>
        </nav>
    </Authorized>
    <NotAuthorized>
        @* Strony bez logowania (logowanie, rejestracja, zaproszenie): panel z opisem aplikacji i formularz *@
        <div class="auth-shell">
            <aside class="auth-hero" aria-label="O aplikacji">
                <div class="app-brand">
                    <AppLogo Size="40" />
                    <span class="app-brand-name"><strong>Fakturowanie KSeF</strong><span>wersja testowa</span></span>
                </div>
                <div>
                    <h2 class="auth-hero-title">Faktury w KSeF bez stresu</h2>
                    <ul class="auth-hero-list">
                        <li><Icon Name="send" Size="18" /> Wystawiasz fakturę i wysyłasz ją do KSeF jednym kliknięciem.</li>
                        <li><Icon Name="inbox" Size="18" /> Faktury kosztowe pobierają się z KSeF same.</li>
                        <li><Icon Name="wallet" Size="18" /> Rozliczenia, przypomnienia o płatności i eksport dla księgowej.</li>
                        <li><Icon Name="sparkles" Size="18" /> Pulpit podpowiada, co jest do zrobienia.</li>
                    </ul>
                </div>
                <p class="auth-hero-note">Wersja testowa: łączy się wyłącznie z testowym środowiskiem KSeF - faktury nie mają mocy prawnej.</p>
            </aside>
            <div class="auth-main">
                <div class="d-flex align-items-center justify-content-between px-3 px-md-4 py-3">
                    <a class="app-brand auth-brand-mobile" href="">
                        <AppLogo />
                        <span class="app-brand-name"><strong>Fakturowanie KSeF</strong><span>wersja testowa</span></span>
                    </a>
                    <span></span>
                    <ThemeToggle />
                </div>
                <main class="px-3 pb-4">
                    @Body
                </main>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool menuOpen;
    private string? search;

    private void ToggleMenu() => menuOpen = !menuOpen;

    private void CloseMenu() => menuOpen = false;

    private void SearchAsync()
    {
        var q = search?.Trim();
        Navigation.NavigateTo(string.IsNullOrEmpty(q) ? "faktury" : $"faktury?q={Uri.EscapeDataString(q)}");
    }

    private static string Initials(string? email)
    {
        if (string.IsNullOrWhiteSpace(email)) return "?";
        var name = email.Split('@')[0];
        var parts = name.Split(['.', '_', '-'], StringSplitOptions.RemoveEmptyEntries);
        var initials = parts.Length >= 2 ? $"{parts[0][0]}{parts[1][0]}" : name[..Math.Min(2, name.Length)];
        return initials.ToUpperInvariant();
    }

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Ctx.Reset();
        Navigation.NavigateTo("login");
    }
}
