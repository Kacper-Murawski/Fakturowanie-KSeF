@* Pozycje faktury (na fakturze korygującej - osobno stan przed i po korekcie) *@
<div class="table-responsive" data-testid="@TestId">
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Lp.</th><th>Nazwa · ilość × cena netto</th><th>VAT</th>
                <th class="text-end">Netto</th><th class="text-end">Brutto</th>
            </tr>
        </thead>
        <tbody>
            @if (Items.Count == 0)
            {
                <tr><td colspan="5" class="text-muted fst-italic">brak pozycji</td></tr>
            }
            @foreach (var i in Items)
            {
                <tr>
                    <td class="muted">@i.Position</td>
                    <td>
                        <span class="fw-semibold">@i.Name</span>
                        <div class="cell-sub">@Format.Quantity(i.Quantity) @i.Unit × @Format.Amount(i.UnitNetPrice)</div>
                    </td>
                    <td class="text-nowrap">@i.VatRate.ToDisplayName()</td>
                    <td class="text-end text-nowrap">@Format.Amount(i.NetAmount)</td>
                    <td class="text-end text-nowrap fw-semibold">@Format.Amount(i.GrossAmount)</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<InvoiceItemDto> Items { get; set; } = [];
    [Parameter] public string? TestId { get; set; }
}
