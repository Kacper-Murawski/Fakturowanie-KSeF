@* Etykieta stanu rozliczenia faktury *@
@if (Status is { } status)
{
    <span class="@Css(status)" data-testid="payment-badge">@Label(status)</span>
}

@code {
    [Parameter] public PaymentStatus? Status { get; set; }
    [Parameter] public bool IsOverdue { get; set; }

    private string Label(PaymentStatus s) => IsOverdue
        ? (s == PaymentStatus.PartiallyPaid ? "Po terminie (częściowo)" : "Po terminie")
        : s switch
        {
            PaymentStatus.Paid => "Opłacona",
            PaymentStatus.PartiallyPaid => "Częściowo opłacona",
            _ => "Nieopłacona"
        };

    private string Css(PaymentStatus s) => IsOverdue ? "pill pill-danger"
        : s switch
        {
            PaymentStatus.Paid => "pill pill-success",
            PaymentStatus.PartiallyPaid => "pill pill-warning",
            _ => "pill"
        };
}
