@* Wysyłka faktury e-mailem i historia wiadomości (D36) *@
@implements IDisposable
@inject ApiClient Api

<section class="surface p-4" data-testid="email-panel">
    <div>
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h2 class="section-title">E-mail</h2>
            @if (!formOpen)
            {
                <div class="d-grid gap-2 w-100 mt-2">
                    <button type="button" class="btn btn-outline-primary" @onclick="() => OpenForm(false)"><Icon Name="mail" Size="16" /> Wyślij e-mailem</button>
                    @if (Remaining > 0)
                    {
                        <button type="button" class="btn btn-outline-secondary" @onclick="() => OpenForm(true)"><Icon Name="bell" Size="16" /> Przypomnij o płatności</button>
                    }
                </div>
            }
        </div>

        @if (formOpen)
        {
            <EditForm Model="model" OnValidSubmit="SendAsync" FormName="invoice-email" class="mt-3">
                <h3 class="h6">@(reminder ? $"Przypomnienie o płatności - pozostało {Format.Money(Remaining ?? 0)}" : "Wysyłka faktury")</h3>
                <DeepValidator @ref="validator" />
                <div class="row g-2">
                    <div class="col-md-6">
                        <label class="form-label small" for="email-to">Adres odbiorcy</label>
                        <InputTextLive id="email-to" type="email" class="form-control" @bind-Value="model.To" />
                        <ValidationMessage For="() => model.To" />
                    </div>
                    <div class="col-12">
                        <label class="form-label small" for="email-message">Dodatkowa wiadomość (opcjonalnie)</label>
                        <InputTextArea id="email-message" class="form-control" rows="3" @bind-Value="model.Message" />
                    </div>
                </div>
                <div class="form-text">
                    @(reminder ? "Wiadomość z kwotą pozostałą do zapłaty, terminem i numerem rachunku. " : "")W załączniku: PDF z kodem QR i XML faktury
                    w postaci z KSeF. Odpowiedzi trafią na adres e-mail Twojej firmy.
                </div>
                <div class="d-flex gap-2 mt-2">
                    <button type="submit" class="btn btn-primary btn-sm" disabled="@busy">@(busy ? "Wysyłanie…" : "Wyślij")</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => formOpen = false">Anuluj</button>
                </div>
            </EditForm>
        }

        <ProblemAlert Problem="problem" />

        @if (messages.Count > 0)
        {
            <table class="table table-sm small mt-3 mb-0" data-testid="email-history">
                <thead><tr><th>Data</th><th>Do</th><th>Rodzaj</th><th>Stan</th></tr></thead>
                <tbody>
                    @foreach (var m in messages)
                    {
                        <tr>
                            <td>@Format.DateTime(m.SentAt ?? m.CreatedAt)</td>
                            <td>@m.To</td>
                            <td>@(m.Kind == EmailKind.PaymentReminder ? "przypomnienie o płatności" : "faktura")</td>
                            <td>
                                @switch (m.Status)
                                {
                                    case EmailStatus.Sent:
                                        <span class="pill pill-success">wysłano</span>
                                        break;
                                    case EmailStatus.Failed:
                                        <span class="pill pill-danger" title="@m.LastError">błąd wysyłki</span>
                                        break;
                                    default:
                                        <span class="pill" title="@m.LastError">@(m.Attempts > 0 ? "ponowna próba wkrótce" : "w kolejce")</span>
                                        break;
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public int InvoiceId { get; set; }
    /// <summary>Pozostało do zapłaty - gdy większe od zera, dostępne jest przypomnienie o płatności.</summary>
    [Parameter] public decimal? Remaining { get; set; }

    private List<EmailMessageDto> messages = [];
    private SendInvoiceEmailRequest model = new();
    private DeepValidator? validator;
    private ApiProblem? problem;
    private bool formOpen;
    private bool reminder;
    private bool busy;
    private Timer? refresh;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        messages = (await Api.GetAsync<List<EmailMessageDto>>($"api/invoices/{InvoiceId}/emails")).Value ?? [];
        // Dopóki są wiadomości w kolejce - odświeżanie stanu
        refresh?.Dispose();
        refresh = messages.Any(m => m.Status == EmailStatus.Pending)
            ? new Timer(_ => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); }), null, TimeSpan.FromSeconds(2), Timeout.InfiniteTimeSpan)
            : null;
    }

    private sealed record Recipient(string? Email);

    private async Task OpenForm(bool asReminder)
    {
        problem = null;
        reminder = asReminder;
        model = new SendInvoiceEmailRequest { To = messages.FirstOrDefault()?.To ?? "" };
        if (model.To.Length == 0)
            model.To = (await Api.GetAsync<Recipient>($"api/invoices/{InvoiceId}/email-recipient")).Value?.Email ?? "";
        formOpen = true;
    }

    private async Task SendAsync()
    {
        busy = true;
        var result = await Api.PostAsync<EmailMessageDto>($"api/invoices/{InvoiceId}/{(reminder ? "reminder" : "email")}", model);
        busy = false;
        problem = result.Problem;
        if (result.Value is not null)
        {
            formOpen = false;
            await LoadAsync();
        }
        else if (problem is not null) validator?.ShowServerErrors(problem);
    }

    public void Dispose() => refresh?.Dispose();
}
